@model BusinessLogicLayer.DTOs.ShoppingCartDtos.ShoppingCartDto

@{
    Layout = "_Layout2";
    ViewData["Title"] = "Your Cart";
}

<div class="cart-page">
    <div class="layout-container mt-5 pt-5">
        <h2 class="cart-title">Your Shopping Cart</h2>

        @if (Model.Items.Count == 0)
        {
            <div class="cart-empty">
                <div class="cart-empty-icon">
                    <i class="bi bi-cart-x"></i>
                </div>
                <h3>Your cart is empty</h3>
                <p>Looks like you haven't added any courses to your cart yet.</p>
                <a asp-controller="Course" asp-action="UserIndex" class="layout-btn layout-btn-primary">
                    <i class="bi bi-journals"></i> Browse Courses
                </a>
            </div>
        }
        else
        {
            <div class="cart-card">
                <div class="cart-header">
                    <h4>Course Items</h4>
                </div>
                <div class="cart-body">
                    <div class="cart-items">
                        @foreach (var item in Model.Items)
                        {
                            <div class="cart-item">
                                <div class="cart-item-image">
                                    <img src="@item.ImagePath" alt="@item.Title" />
                                </div>
                                <div class="cart-item-info">
                                    <h5 class="cart-item-title">@item.Title</h5>
                                    <div class="cart-item-price">@item.Price.ToString("C", new System.Globalization.CultureInfo("en-US"))</div>
                                </div>
                                <div class="cart-item-actions">
                                    <a asp-action="RemoveFromCart" asp-route-id="@item.Course_ID" class="cart-remove-btn">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="cart-footer">
                    <div class="cart-subtotal">
                        <span>Subtotal:</span>
                        <span class="cart-total-amount">@Model.Items.Sum(i => i.Price).ToString("C", new System.Globalization.CultureInfo("en-US"))</span>
                    </div>
                    <div class="cart-actions">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <a asp-controller="Order" asp-action="Checkout" class="layout-btn layout-btn-primary cart-checkout-btn">
                                <i class="bi bi-credit-card"></i> Proceed to Checkout
                            </a>
                        }
                        else
                        {
                            <div class="cart-login-notice">
                                <i class="bi bi-exclamation-circle"></i>
                                <p>Please <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Index", "ShoppingCart")">log in</a> to proceed to checkout.</p>
                            </div>
                        }
                        <a asp-controller="Course" asp-action="UserIndex" class="layout-btn layout-btn-outline">
                            <i class="bi bi-arrow-left"></i> Continue Shopping
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .cart-page {
        padding-top: 80px;
        padding-bottom: 120px;
        min-height: calc(100vh - 200px);
        background-color: #f9fafb;
        height: 100vh;
        margin-top: 80px;
    }
    
    .cart-title {
        text-align: center;
        margin-bottom: 2.5rem;
        color: #1A1F2C;
    }
    
    .cart-empty {
        background-color: white;
        border-radius: 0.5rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        padding: 3.5rem 2rem;
        max-width: 600px;
        margin: 0 auto 3rem;
        text-align: center;
    }
    
    .cart-empty-icon {
        font-size: 5rem;
        color: #9ca3af;
        margin-bottom: 1.5rem;
    }
    
    .cart-empty h3 {
        font-size: 1.5rem;
        margin-bottom: 1rem;
        color: #1A1F2C;
    }
    
    .cart-empty p {
        color: #4b5563;
        margin-bottom: 2rem;
    }
    
    .cart-card {
        background-color: white;
        border-radius: 0.5rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        overflow: hidden;
        margin-bottom: 3rem;
    }
    
    .cart-header {
        background-color: #f8f9fa;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid #e9ecef;
    }
    
    .cart-header h4 {
        margin: 0;
        color: #1A1F2C;
        font-weight: 600;
    }
    
    .cart-body {
        padding: 0;
    }
    
    .cart-items {
        display: flex;
        flex-direction: column;
    }
    
    .cart-item {
        display: flex;
        align-items: center;
        padding: 1.5rem;
        border-bottom: 1px solid #e9ecef;
    }
    
    .cart-item:last-child {
        border-bottom: none;
    }
    
    .cart-item-image {
        width: 100px;
        height: 70px;
        margin-right: 1.5rem;
        flex-shrink: 0;
        border-radius: 0.25rem;
        overflow: hidden;
    }
    
    .cart-item-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .cart-item-info {
        flex: 1;
    }
    
    .cart-item-title {
        margin: 0 0 0.5rem 0;
        font-weight: 600;
        font-size: 1.125rem;
        color: #1A1F2C;
    }
    
    .cart-item-price {
        font-weight: 600;
        color: #00b8a9;
    }
    
    .cart-item-actions {
        margin-left: 1.5rem;
    }
    
    .cart-remove-btn {
        color: #ef4444;
        font-size: 1.25rem;
        background: none;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 9999px;
    }
    
    .cart-remove-btn:hover {
        background-color: rgba(239, 68, 68, 0.1);
    }
    
    .cart-footer {
        padding: 1.5rem;
        border-top: 1px solid #e9ecef;
    }
    
    .cart-subtotal {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px dashed #e9ecef;
        font-size: 1.125rem;
    }
    
    .cart-total-amount {
        font-weight: 700;
        font-size: 1.5rem;
        color: #00b8a9;
    }
    
    .cart-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }
    
    .cart-checkout-btn {
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .cart-login-notice {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        background-color: rgba(251, 191, 36, 0.1);
        padding: 1rem 1.5rem;
        border-radius: 0.5rem;
        margin-bottom: 1rem;
        width: 100%;
    }
    
    .cart-login-notice i {
        font-size: 1.5rem;
        color: #f59e0b;
        flex-shrink: 0;
    }
    
    .cart-login-notice p {
        margin: 0;
        color: #92400e;
    }
    
    .cart-login-notice a {
        color: #00b8a9;
        font-weight: 600;
        text-decoration: underline;
    }
    
    @@media (max-width: 768px) {
        .cart-actions {
            flex-direction: column;
            align-items: stretch;
        }
        
        .cart-item {
            flex-direction: column;
            align-items: flex-start;
            padding: 1.25rem;
        }
        
        .cart-item-image {
            width: 100%;
            height: 150px;
            margin-right: 0;
            margin-bottom: 1rem;
        }
        
        .cart-item-actions {
            margin-left: 0;
            margin-top: 1rem;
            align-self: flex-end;
        }
        
        .cart-subtotal {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }
        
        .cart-empty {
            padding: 2.5rem 1.5rem;
            margin: 1.5rem 1rem 3rem;
        }
    }
</style>

