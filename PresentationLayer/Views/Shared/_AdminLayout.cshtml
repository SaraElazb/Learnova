@using System
@using System.Globalization
@functions {
    public string IsActive(string controller, string action = null)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        if (action == null)
        {
            return string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
                ? "active" : "";
        }
        return (string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase))
            ? "active" : "";
    }
    
    public string GetAvatarUrl(string userName)
    {
        if (string.IsNullOrEmpty(userName))
            return "https://ui-avatars.com/api/?name=User&background=10B981&color=ffffff";
            
        // Get the first letter of each word in the name and combine them
        string initials = string.Join("", userName.Split(' ')
            .Where(n => !string.IsNullOrEmpty(n))
            .Select(n => n[0].ToString().ToUpper()));
            
        // Limit to 2 characters if there are more
        if (initials.Length > 2)
            initials = initials.Substring(0, 2);
            
        // Generate placeholder avatar URL with user's initials
        return $"https://ui-avatars.com/api/?name={initials}&background=10B981&color=ffffff";
    }
}
