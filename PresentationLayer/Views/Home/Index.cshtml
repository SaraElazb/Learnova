@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Mvc.Rendering
@model IEnumerable<BusinessLogicLayer.DTOs.CourseDtos.CourseDTO>

@{
    var categories = ViewBag.Categories as List<SelectListItem>;
    var selectedCategoryId = ViewBag.SelectedCategoryId as int?;
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>LearnNova</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/homepage.css">
    <style>
        /* Dropdown menu styles */
        .profile-dropdown {
            position: relative;
            display: inline-block;
        }

        .profile-button {
            background: none;
            border: none;
            padding: 8px 16px;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            font-weight: 500;
            color: var(--text-primary);
            transition: color 0.3s;
        }

        .profile-button:hover {
            color: var(--primary);
        }
        
        .profile-button span {
            display: inline-block;
            max-width: 120px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .profile-dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            background-color: white;
            min-width: 200px;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
            z-index: 1000;
            padding: 8px 0;
        }

        .profile-dropdown-content a {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #000000;
            padding: 10px 16px;
            text-decoration: none;
            font-size: 14px;
            transition: background-color 0.2s;
        }

        .profile-dropdown-content a:hover {
            background-color: #f8f9fa;
            color: var(--primary);
        }

        .dropdown-divider {
            height: 1px;
            background-color: #e9ecef;
            margin: 8px 0;
        }

        .profile-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background-color: #e9ecef;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 600;
            color: #495057;
        }

        .show {
            display: block;
        }
        
        /* Role-specific coloring */
        .role-student .profile-avatar {
            background-color: #4e73df;
            color: white;
        }
        
        .role-teacher .profile-avatar {
            background-color: #1cc88a;
            color: white;
        }
        
        .role-admin .profile-avatar {
            background-color: #e74a3b;
            color: white;
        }
    </style>
</head>
<body>
<div class="site-wrapper">
    <header class="navbar">
        <div class="container">
            <div class="navbar-left">
                <a href="/" class="logo">
                    <img src="~/assets/logonoslogan.png" alt="logo" class="logo-img">
                </a>
                <nav class="main-nav">
                    <a asp-controller="Course" asp-action="UserIndex" class="nav-link">Courses</a>
                    <a href="#" class="nav-link">How it works</a>
                    <a href="#" class="nav-link">About Us</a>
                    @if (User.Identity!.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Dashboard" class="nav-link">Dashboard</a>
                    }
                </nav>
            </div>
            <div class="navbar-right">
                <form method="get" action="/Courses" class="search-box">
                    <input type="text" name="searchTerm" placeholder="Search courses...">
                    <button type="submit" class="search-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </button>
                </form>
                @if (User.Identity.IsAuthenticated)
                {
                    <div class="profile-dropdown">
                        <button class="profile-button" onclick="toggleDropdown()">
                            <div class="profile-avatar @(User.IsInRole("Admin") ? "role-admin" : User.IsInRole("Teacher") ? "role-teacher" : "role-student")">
                                @{
                                    var username = User.Identity.Name;
                                    var initial = !string.IsNullOrEmpty(username) ? username[0].ToString().ToUpper() : "U";
                                }
                                @initial
                            </div>
                            <span>@User.Identity.Name</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="profile-dropdown-content" id="profileDropdown">
                            @if (User.IsInRole("Teacher"))
                            {
                                <a asp-controller="Instructor" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2"></i> Instructor Dashboard
                                </a>
                                <a asp-controller="Instructor" asp-action="Courses">
                                    <i class="bi bi-book"></i> My Courses
                                </a>
                                <a asp-controller="Instructor" asp-action="Quizzes">
                                    <i class="bi bi-question-circle"></i> My Quizzes
                                </a>
                            }
                            else if (User.IsInRole("Student"))
                            {
                                <a asp-controller="Student" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2"></i> Student Dashboard
                                </a>
                                <a asp-controller="Student" asp-action="MyCourses">
                                    <i class="bi bi-book"></i> My Courses
                                </a>
                                <a asp-controller="Student" asp-action="MyQuizzes">
                                    <i class="bi bi-question-circle"></i> My Quizzes
                                </a>
                            }
                            else if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="Admin" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2"></i> Admin Dashboard
                                </a>
                                <a asp-controller="Course" asp-action="List">
                                    <i class="bi bi-book"></i> Manage Courses
                                </a>
                                <a asp-controller="Category" asp-action="Index">
                                    <i class="bi bi-tags"></i> Manage Categories
                                </a>
                                <a asp-controller="User" asp-action="Index">
                                    <i class="bi bi-people"></i> Manage Users
                                </a>
                            }
                            <a href="#">
                                <i class="bi bi-person"></i> Profile
                            </a>
                            <a href="#">
                                <i class="bi bi-gear"></i> Settings
                            </a>
                            <div class="dropdown-divider"></div>
                            <form asp-controller="Account" asp-action="LogOut" method="post" style="margin: 0;">
                                <button type="submit" style="display: flex; align-items: center; gap: 10px; color: #000000; padding: 10px 16px; text-decoration: none; font-size: 14px; background: none; border: none; cursor: pointer; width: 100%; text-align: left;">
                                    <i class="bi bi-box-arrow-right"></i> Log out
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a class="btn btn-ghost" asp-controller="Account" asp-action="LogIn">Log in</a>
                    <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Sign up</a>
                }
            </div>
        </div>
    </header>

    <main>
        <section class="hero">
            <div class="container">
                <div class="hero-grid">
                    <div class="hero-content fade-in">
                        <h1 class="hero-title">
                            Advance Your Career<br>
                            <span>in a Digitalized World</span>
                        </h1>
                        <p class="hero-subtitle">
                            We provide you with curated tech courses from the top institutions, allowing you to learn hundreds of
                            practical business and design skills.
                        </p>
                        <form method="get" action="/Courses" class="hero-search">
                            <input type="text" name="searchTerm" placeholder="Python, UX/UI Design, Web Dev...">
                        </form>
                    </div>
                    <div class="hero-image fade-in">
                        <div class="image-container">
                            <img src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?ixlib=rb-4.0.3" alt="Student learning online">
                        </div>
                        <div class="stats-card stats-card-bottom">
                            <p>Join Us on Our Learning Revolution</p>
                        </div>
                        <div class="stats-card stats-card-top">
                            <p>Empowering Learning for Everyone</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="courses">
            <div class="container">
                <div class="courses-header">
                    <div>
                        <p class="section-tag fade-in">Popular Courses</p>
                        <h2 class="section-title fade-in">Explore a Growing Library of Courses</h2>
                    </div>
                    <p class="section-description fade-in">
                        We provide a range of categories to help you choose courses and get the skills you need.
                        There's something for everyone.
                    </p>
                </div>
                <div class="categories-slider fade-in">
                    <a class="category-btn @(selectedCategoryId == null ? "active" : "")" href="/">
                        All Categories
                    </a>
                    @if (categories != null && categories.Any())
                    {
                        foreach (var category in categories)
                        {
                            bool isActive = selectedCategoryId.HasValue && selectedCategoryId.Value.ToString() == category.Value;
                            <a class="category-btn @(isActive ? "active" : "")" href="/?categoryId=@category.Value">
                                @category.Text
                            </a>
                        }
                    }
                    else
                    {
                        <span>No categories found.</span>
                    }
                </div>
                <div class="courses-grid">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var course in Model.Take(3))
                        {
                            <div class="course-card fade-in">
                                <div class="course-image">
                                    <img src="@course.ImagePath" alt="@course.Title">
                                    <div class="course-category">@course.CategoryName</div>
                                </div>
                                <div class="course-content">
                                    <h3 class="course-title">@course.Title</h3>
                                    <div class="course-meta">
                                        <div class="meta-item">
                                            <span>★ 4.8</span>
                                        </div>
                                        <div class="meta-item">
                                            <span>2345</span>
                                        </div>
                                        <div class="meta-item">
                                            <span>6 weeks</span>
                                        </div>
                                    </div>
                                    <div class="course-footer">
                                        <span class="course-price">$@course.Price</span>
                                        <a class="course-view-btn" href="/Course/Details/@course.Course_ID">
                                            View Course
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p>No courses found.</p>
                    }
                </div>
                <div class="courses-footer">
                    <button class="btn btn-outline fade-in" onclick="location.href='/Courses';">More Courses</button>
                </div>
            </div>
        </section>

        <section class="cta-section fade-in">
            <div class="container">
                <h2 class="cta-title">Ready to Start Your Learning Journey?</h2>
                <p class="cta-description">
                    Join thousands of students worldwide and advance your career with our cutting-edge courses.
                </p>
                <button class="btn btn-cta">Get Started Today</button>
            </div>
        </section>
    </main>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-logo">
                    <img src="~/assets/logonoslogan.png" class="logo-img" alt="logo">
                </div>
                <div class="footer-links">
                    <a href="#" class="footer-link">Terms</a>
                    <a href="#" class="footer-link">Privacy</a>
                    <a href="#" class="footer-link">Contact</a>
                </div>
                <div class="footer-copyright">
                    ©2025 LearnNova. All rights reserved.
                </div>
            </div>
        </div>
    </footer>
    <div class="bg-gradient bg-gradient-1"></div>
    <div class="bg-gradient bg-gradient-2"></div>
</div>
<script src="~/js/homepage.js"></script>
<script>
    function toggleDropdown() {
        document.getElementById("profileDropdown").classList.toggle("show");
    }

    // Close the dropdown if the user clicks outside of it
    window.onclick = function(event) {
        if (!event.target.matches('.profile-button') && 
            !event.target.matches('.profile-button *')) {
            var dropdowns = document.getElementsByClassName("profile-dropdown-content");
            for (var i = 0; i < dropdowns.length; i++) {
                var openDropdown = dropdowns[i];
                if (openDropdown.classList.contains('show')) {
                    openDropdown.classList.remove('show');
                }
            }
        }
    }
</script>
</body>
</html>
