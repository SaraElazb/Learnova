@using Microsoft.AspNetCore.Mvc.TagHelpers
@using System.Linq
@model BusinessLogicLayer.DTOs.CourseDtos.CourseDTO

@{
    ViewData["Title"] = Model.Title;
    Layout = "_Layout2";
}
@section CustomHeadContent {
    <link rel="stylesheet" href="~/css/course-details.css" />
}

<!-- Hero Section -->
<section class="course-hero">
    <div class="container">
        <div class="hero-content">
            <div class="category-label">@Model.CategoryName</div>
            <h1 class="course-title">@Model.Title</h1>

            <div class="course-meta">
                <div class="meta-item">
                    <span class="star-icon">★</span>
                    <span>@Model.Rating.ToString("0.0")</span>
                    <span class="meta-text">(Rating)</span>
                </div>
                <div class="meta-item">
                    <span class="meta-icon">👥</span>
                    <span class="meta-text">Students enrolled</span>
                </div>
                <div class="meta-item">
                    <span class="meta-icon">⏱️</span>
                    <span class="meta-text">Created @Model.CreatedDate.ToString("MMM dd, yyyy")</span>
                </div>
            </div>

            <p class="course-brief">
                @Model.Description
            </p>

            <a href="#curriculum" class="btn btn-outline view-curriculum-btn">View Curriculum</a>
        </div>

        <div class="course-card">
            <img src="@(string.IsNullOrEmpty(Model.ImagePath) ? "/assets/course-placeholder.jpg" : Model.ImagePath)" 
                 alt="@Model.Title" 
                 class="course-thumbnail">
            <div class="card-content">
                <div class="course-price">$@Model.Price</div>
                <button class="btn btn-enroll" data-course-id="@Model.Course_ID">Enroll Now</button>
                <div class="guarantee">30-Day Money-Back Guarantee</div>
                <div class="course-includes">
                    <div class="include-item">
                        <span class="include-icon">📹</span>
                        <span>Full lifetime access</span>
                    </div>
                    <div class="include-item">
                        <span class="include-icon">📱</span>
                        <span>Access on mobile and desktop</span>
                    </div>
                    <div class="include-item">
                        <span class="include-icon">🏆</span>
                        <span>Certificate of completion</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Main Content -->
<section class="main-content">
    <div class="container">
        <div class="course-content">
            <div class="content-section" id="description">
                <h2 class="section-title">Course Description</h2>
                <p>@Model.Description</p>
                
                <div class="highlights">
                    <h3>What you'll learn</h3>
                    <ul class="highlights-list">
                        <li class="highlight-item">
                            <span class="highlight-icon">✓</span>
                            <span>Master the core concepts and features of this subject</span>
                        </li>
                        <li class="highlight-item">
                            <span class="highlight-icon">✓</span>
                            <span>Build real-world projects to apply your knowledge</span>
                        </li>
                        <li class="highlight-item">
                            <span class="highlight-icon">✓</span>
                            <span>Learn best practices and optimization techniques</span>
                        </li>
                        <li class="highlight-item">
                            <span class="highlight-icon">✓</span>
                            <span>Understand advanced concepts and techniques</span>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="content-section" id="curriculum">
                <h2 class="section-title">Course Curriculum</h2>
                <div class="curriculum-list">
                    @if (ViewBag.Lessons != null && ((IEnumerable<BusinessLogicLayer.DTOs.LessonDtos.LessonDto>)ViewBag.Lessons).Any())
                    {
                        @foreach (var lesson in (IEnumerable<BusinessLogicLayer.DTOs.LessonDtos.LessonDto>)ViewBag.Lessons)
                        {
                            <div class="curriculum-item">
                                <div class="curriculum-header">
                                    <h3 class="curriculum-title">@lesson.Title</h3>
                                    <span class="curriculum-toggle">+</span>
                                </div>
                                <div class="curriculum-content">
                                    <ul class="curriculum-list-items">
                                        <li>@lesson.Description</li>
                                        <li>Duration: @lesson.Duration minutes</li>
                                        @if (!string.IsNullOrEmpty(lesson.VideoUri))
                                        {
                                            <li>Video: <a href="@lesson.VideoUri" target="_blank">Watch Video</a></li>
                                        }
                                        @if (lesson.Quiz_ID != null)
                                        {
                                            <li>Quiz: <a href="@Url.Action("Details", "Quiz", new { id = lesson.Quiz_ID })">Take Quiz</a></li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="no-lessons-message">
                            <p>No lessons available for this course yet.</p>
                        </div>
                    }
                </div>
            </div>

            <div class="content-section">
                <h2 class="section-title">Your Instructor</h2>
                <div class="instructor">
                    <img src="/assets/instructor-placeholder.jpg" alt="Instructor" class="instructor-avatar">
                    <div class="instructor-info">
                        <h3 class="instructor-name">Course Instructor</h3>
                        <p class="instructor-title">Expert in @Model.CategoryName</p>
                        <p class="instructor-bio">
                            Our instructors are experts in their fields with real-world experience. 
                            They provide high-quality education to help you achieve your goals.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>



<!-- Fixed CTA for mobile -->
<div class="mobile-cta">
    <div class="mobile-price">$@Model.Price</div>
    <button class="btn btn-enroll" data-course-id="@Model.Course_ID">Enroll Now</button>
</div>

@section CustomScripts {
    <script src="~/js/course-details.js"></script>
}

