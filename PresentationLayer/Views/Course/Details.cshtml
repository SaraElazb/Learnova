@using Microsoft.AspNetCore.Mvc.TagHelpers
@model BusinessLogicLayer.DTOs.CourseDtos.CourseDTO

@{
    ViewData["Title"] = "Course Details";
}

<h2>@Model.Title</h2>
<img src="@Model.ImagePath" class="img-fluid" alt="Course Image">
<p><strong>Category:</strong> @Model.CategoryName</p>
<p><strong>Description:</strong> @Model.Description</p>
<p><strong>Price:</strong> $@Model.Price</p>
<p><strong>Rating:</strong> @Model.Rating / 5</p>
<p><strong>Created On:</strong> @Model.CreatedDate.ToString("yyyy-MM-dd")</p>

<a class="btn btn-secondary" asp-action="UserIndex">Back to Courses</a>
