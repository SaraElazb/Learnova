@using Microsoft.AspNetCore.Mvc.TagHelpers
@model BusinessLogicLayer.DTOs.CourseDtos.CourseDTO

@{
    ViewData["Title"] = "Course Details";
    // Layout = null;
    Layout = "_Layout2";
}
@section CustomHeadContent {
    <link rel="stylesheet" href="~/css/course-info.css" />
}
<!-- Hero Section -->
<section class="hero">
    <div class="container">
        <div class="hero-content">
            <div class="category-label">Development</div>
            <h1 class="course-title">Complete JavaScript: From Fundamentals to Advanced Concepts</h1>

            <div class="course-meta">
                <div class="meta-item">
                    <i class="fas fa-star"></i>
                    <span>4.8</span>
                    <span class="meta-text">(1,245 ratings)</span>
                </div>
                <div class="meta-item">
                    <i class="fas fa-users"></i>
                    <span class="meta-text">7,890 students</span>
                </div>
                <div class="meta-item">
                    <i class="fas fa-clock"></i>
                    <span class="meta-text">42 hours</span>
                </div>
            </div>

            <p class="course-brief">
                Master JavaScript from the ground up and build complex real-world applications with
                confidence. Updated for 2025 with the latest features and best practices.
            </p>
        </div>

        <div class="course-card">
            <img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085" alt="JavaScript Course"
                 class="course-image">
            <div class="card-content">
                <div class="course-price">$89.99</div>
                <button class="btn btn-cta">Enroll Now</button>
                <div class="guarantee">30-Day Money-Back Guarantee</div>
                <div class="course-includes">
                    <div class="include-item">
                        <i class="fas fa-video"></i>
                        <span>42 hours on-demand video</span>
                    </div>
                    <div class="include-item">
                        <i class="fas fa-file"></i>
                        <span>75 articles & resources</span>
                    </div>
                    <div class="include-item">
                        <i class="fas fa-code"></i>
                        <span>25 coding exercises</span>
                    </div>
                    <div class="include-item">
                        <i class="fas fa-certificate"></i>
                        <span>Certificate of completion</span>
                    </div>
                    <div class="include-item">
                        <i class="fas fa-mobile-alt"></i>
                        <span>Mobile access</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Main Content -->
<section class="main-content">
    <div class="container">
        <div class="content-container">
            <div class="course-description">
                <h2>Course Description</h2>
                <p>
                    This comprehensive JavaScript course is designed to take you from beginner to advanced level. You'll
                    start with the fundamentals and gradually progress to complex concepts like asynchronous programming, ES6+
                    features, and building real-world applications.
                </p>

                <p>
                    Whether you're aiming to become a front-end developer, back-end developer with Node.js, or a full-stack
                    JavaScript developer, this course provides all the knowledge and practical experience you need to succeed
                    in the field.
                </p>

                <div class="highlights">
                    <h3>What you'll learn</h3>
                    <ul>
                        <li>Master JavaScript fundamentals including variables, data types, functions, and objects</li>
                        <li>Understand advanced concepts like closures, prototypal inheritance, and the 'this' keyword</li>
                        <li>Build interactive web applications using DOM manipulation and event handling</li>
                        <li>
                            Work with modern JavaScript features (ES6+) including arrow functions, destructuring, and modules
                        </li>
                        <li>Implement asynchronous programming with Promises, async/await, and API calls</li>
                        <li>Apply object-oriented and functional programming paradigms in JavaScript</li>
                        <li>Debug JavaScript applications and write clean, maintainable code</li>
                    </ul>
                </div>
            </div>

            <div class="syllabus-section">
                <h2>Course Syllabus</h2>
                <div class="accordion">
                    <div class="accordion-item">
                        <div class="accordion-header">
                            <h3>Module 1: Getting Started with JavaScript</h3>
                            <span class="accordion-icon">+</span>
                        </div>
                        <div class="accordion-content">
                            <ul>
                                <li>Introduction to JavaScript and its role in web development</li>
                                <li>Setting up your development environment</li>
                                <li>JavaScript basics: variables, data types, and operators</li>
                                <li>Control flow: conditionals and loops</li>
                                <li>Hands-on exercise: Build a simple calculator</li>
                            </ul>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-header">
                            <h3>Module 2: Functions and Objects</h3>
                            <span class="accordion-icon">+</span>
                        </div>
                        <div class="accordion-content">
                            <ul>
                                <li>Function declarations, expressions, and arrow functions</li>
                                <li>Function parameters, return values, and scope</li>
                                <li>Objects, properties, and methods</li>
                                <li>Working with arrays and array methods</li>
                                <li>Project: Building a task management application</li>
                            </ul>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-header">
                            <h3>Module 3: DOM Manipulation and Events</h3>
                            <span class="accordion-icon">+</span>
                        </div>
                        <div class="accordion-content">
                            <ul>
                                <li>Understanding the Document Object Model (DOM)</li>
                                <li>Selecting and manipulating DOM elements</li>
                                <li>Event listeners and event handling</li>
                                <li>Creating, removing, and modifying HTML elements</li>
                                <li>Project: Interactive web page development</li>
                            </ul>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-header">
                            <h3>Module 4: Advanced JavaScript Concepts</h3>
                            <span class="accordion-icon">+</span>
                        </div>
                        <div class="accordion-content">
                            <ul>
                                <li>Closures and lexical scope</li>
                                <li>This keyword and execution context</li>
                                <li>Prototypal inheritance and the prototype chain</li>
                                <li>Error handling with try/catch</li>
                                <li>Advanced project: Building a custom JavaScript library</li>
                            </ul>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-header">
                            <h3>Module 5: Asynchronous JavaScript</h3>
                            <span class="accordion-icon">+</span>
                        </div>
                        <div class="accordion-content">
                            <ul>
                                <li>Understanding synchronous vs. asynchronous code</li>
                                <li>Callbacks and callback hell</li>
                                <li>Promises and promise chaining</li>
                                <li>Async/await syntax</li>
                                <li>Fetching data from APIs</li>
                                <li>Project: Weather application with API integration</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="instructor-section">
                <h2>Your Instructor</h2>
                <div class="instructor">
                    <img src="https://images.unsplash.com/photo-1580489944761-15a19d654956?ixlib=rb-1.2.1&auto=format&fit=crop&w=300&q=80"
                         alt="Sarah Johnson" class="instructor-avatar">
                    <div class="instructor-info">
                        <h3>Sarah Johnson</h3>
                        <p class="instructor-title">Senior Front-End Developer | 10+ Years Experience</p>
                        <p class="instructor-bio">
                            Sarah is a passionate JavaScript educator with over a decade of experience in
                            web development. She has worked with Fortune 500 companies and startups alike, helping teams build
                            scalable front-end architectures. With 15 courses and over 300,000 students worldwide, Sarah is
                            dedicated to making complex programming concepts accessible to learners of all levels.
                        </p>
                    </div>
                </div>
            </div>

            <div class="reviews-section">
                <div class="reviews-header">
                    <h2>Student Reviews</h2>
                    <div class="overall-rating">
                        <div class="rating-number">4.8</div>
                        <div class="stars">★★★★★</div>
                        <div class="rating-count">1,245 ratings</div>
                    </div>
                </div>

                <div class="review">
                    <div class="review-header">
                        <div class="reviewer-info">
                            <div class="reviewer-initial">M</div>
                            <div class="reviewer-name">Michael T.</div>
                        </div>
                        <div class="review-rating">★★★★★</div>
                    </div>
                    <p class="review-content">
                        This course completely transformed my JavaScript skills. The instructor explains
                        complex topics in a way that's easy to understand and the projects helped me put everything into
                        practice. Highly recommend to anyone wanting to master JavaScript!
                    </p>
                </div>

                <div class="review">
                    <div class="review-header">
                        <div class="reviewer-info">
                            <div class="reviewer-initial">A</div>
                            <div class="reviewer-name">Alexandra P.</div>
                        </div>
                        <div class="review-rating">★★★★★</div>
                    </div>
                    <p class="review-content">
                        Coming from a non-technical background, I was worried about learning JavaScript,
                        but Sarah's teaching style made it approachable and fun. The course is comprehensive and the pace is
                        perfect for beginners while still covering advanced topics.
                    </p>
                </div>

                <div class="review">
                    <div class="review-header">
                        <div class="reviewer-info">
                            <div class="reviewer-initial">J</div>
                            <div class="reviewer-name">James L.</div>
                        </div>
                        <div class="review-rating">★★★★</div>
                    </div>
                    <p class="review-content">
                        Great course overall with excellent explanations and examples. The only reason
                        I'm giving 4 stars instead of 5 is that some of the later modules could use more practical examples.
                        Otherwise, this is one of the best JavaScript courses I've taken.
                    </p>
                </div>

                <button class="btn btn-outline btn-full">Show All Reviews</button>
            </div>
        </div>

        <div class="related-courses">
            <h2>Related Courses</h2>
            <div class="courses-grid">
                <div class="course-item">
                    <img src="https://images.unsplash.com/photo-1461749280684-dccba630e2f6" alt="React for Beginners"
                         class="course-thumbnail">
                    <div class="course-info">
                        <div class="category-label small">Development</div>
                        <h3>React for Beginners: Build Modern Web Applications</h3>
                        <div class="course-meta small">
                            <span class="stars">★★★★★</span>
                            <span>4.7 (982 ratings)</span>
                        </div>
                        <div class="course-price small">$79.99</div>
                    </div>
                </div>

                <div class="course-item">
                    <img src="https://images.unsplash.com/photo-1486312338219-ce68d2c6f44d" alt="Node.js Masterclass"
                         class="course-thumbnail">
                    <div class="course-info">
                        <div class="category-label small">Development</div>
                        <h3>Node.js Masterclass: Server-Side JavaScript</h3>
                        <div class="course-meta small">
                            <span class="stars">★★★★★</span>
                            <span>4.6 (756 ratings)</span>
                        </div>
                        <div class="course-price small">$94.99</div>
                    </div>
                </div>

                <div class="course-item">
                    <img src="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158" alt="Modern Web Design"
                         class="course-thumbnail">
                    <div class="course-info">
                        <div class="category-label small">Design</div>
                        <h3>Modern Web Design: HTML5 & CSS3 Fundamentals</h3>
                        <div class="course-meta small">
                            <span class="stars">★★★★★</span>
                            <span>4.8 (1,103 ratings)</span>
                        </div>
                        <div class="course-price small">$69.99</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- Fixed CTA for mobile -->
<div class="mobile-cta">
    <div class="mobile-price">$89.99</div>
    <button class="btn btn-cta">Enroll Now</button>
</div>


@section CustomScripts {
    <script src="~/js/course-info.js"></script>
}

