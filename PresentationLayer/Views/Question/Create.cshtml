@model BusinessLogicLayer.DTOs.QuizDtos.QuestionRequest

@{
    ViewData["Title"] = "Add Question";
    Layout = "_Layout2";
}

@section CustomHeadContent {
    <link rel="stylesheet" href="~/css/quiz.css">
}

<div class="quiz-container">
    <div class="quiz-breadcrumb animate-fade-in">
        <a asp-controller="Quiz" asp-action="AdminIndex">Quizzes</a>
        <span class="quiz-breadcrumb-separator">•</span>
        <a asp-action="Index" asp-route-quizId="@Model.QuizID">Questions</a>
        <span class="quiz-breadcrumb-separator">•</span>
        <span>Add Question</span>
    </div>

    <div class="quiz-header">
        <h1 class="quiz-title animate-fade-in">Add New Question</h1>
    </div>
    
    <div class="quiz-content animate-fade-in animate-delay-100">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="quiz-alert quiz-alert-error">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <p>@TempData["ErrorMessage"]</p>
            </div>
        }

     
        
        <div class="quiz-main">
            <form asp-action="Create" method="post" class="quiz-form" id="createQuestionForm">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <!-- Essential hidden fields -->
                <input type="hidden" asp-for="QuizID" id="QuizID" value="@Model.QuizID" />
                <input type="hidden" asp-for="RightAns" id="RightAns" />
                
                <!-- Debug info for form values -->
                <div style="display: none;" id="debug-info" data-quiz-id="@Model.QuizID"></div>
                
                <div class="form-group">
                    <label asp-for="QuestionText" class="form-label">Question Text</label>
                    <textarea asp-for="QuestionText" class="form-textarea" rows="3" required></textarea>
                    <span asp-validation-for="QuestionText" class="text-danger"></span>
                </div>
                
                <div class="form-group">
                    <label asp-for="Score" class="form-label">Score</label>
                    <input asp-for="Score" class="form-input" type="number" min="1" value="10" required />
                    <span asp-validation-for="Score" class="text-danger"></span>
                </div>
                
                <div class="form-group">
                    <label class="form-label">Answer Options</label>
                    <div class="answer-options-container" style="background-color: var(--brand-teal-light); padding: 1.5rem; border-radius: var(--border-radius);">
                        <div class="quiz-alert quiz-alert-info" style="margin-bottom: 1rem;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="16" x2="12" y2="12"></line>
                                <line x1="12" y1="8" x2="12.01" y2="8"></line>
                            </svg>
                            <div>
                                <p style="margin-bottom: 0.5rem;"><strong>Instructions:</strong></p>
                                <ol style="margin-left: 1.5rem; margin-bottom: 0;">
                                    <li>Fill in at least one answer option</li>
                                    <li>Select the radio button next to the correct answer</li>
                                    <li>Empty answer fields will be ignored</li>
                                    <li>Maximum 200 characters per answer</li>
                                </ol>
                            </div>
                        </div>
                        
                        <div id="answer-options">
                            @for (int i = 0; i < 4; i++)
                            {
                                <div class="answer-option" style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
                                    <div class="answer-radio" style="flex-shrink: 0;">
                                        <input type="radio" id="rightAnswer_@i" name="rightAnswerRadio" value="@i" required 
                                               style="width: 1.25rem; height: 1.25rem; cursor: pointer;">
                                    </div>
                                    <div style="flex-grow: 1;">
                                        <label for="rightAnswer_@i" style="width: 100%;">
                                            <input name="Answers[@i]" id="Answers_@i" class="form-input answer-input" 
                                                   placeholder="Answer option @(i+1)" value="" maxlength="200" />
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                
                <div class="quiz-actions">
                    <a asp-action="Index" asp-route-quizId="@Model.QuizID" class="quiz-btn quiz-btn-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="19" y1="12" x2="5" y2="12"></line>
                            <polyline points="12 19 5 12 12 5"></polyline>
                        </svg>
                        Back to Questions
                    </a>
                    <button type="submit" id="submitButton" class="quiz-btn quiz-btn-primary">
                        Create Question
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section CustomScripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" 
            integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4=" 
            crossorigin="anonymous"></script>
    <script>
        $(document).ready(function() {
            // Animations
            const fadeElements = document.querySelectorAll('.animate-fade-in');
            fadeElements.forEach(function(element) {
                element.classList.add('visible');
            });
            
            // Verify quiz ID is set
            const quizId = $('#QuizID').val();
            console.log('Quiz ID:', quizId);
            
            // Pre-set the first radio button if none is selected
            if ($('input[name="rightAnswerRadio"]:checked').length === 0) {
                $('input[name="rightAnswerRadio"]:first').prop('checked', true);
            }
            
            // Set initial right answer based on selection
            function updateRightAnswer() {
                const selectedRadio = $('input[name="rightAnswerRadio"]:checked');
                if (selectedRadio.length > 0) {
                    const selectedIndex = selectedRadio.val();
                    const answerText = $(`#Answers_${selectedIndex}`).val().trim();
                    console.log('Setting RightAns to:', answerText);
                    $('#RightAns').val(answerText);
                }
            }
            
            // When a radio button is clicked
            $('input[name="rightAnswerRadio"]').change(function() {
                updateRightAnswer();
            });
            
            // When answer text changes and it's the selected answer
            $('.answer-input').on('input', function() {
                const inputId = $(this).attr('id');
                const index = inputId.split('_')[1];
                
                if ($(`#rightAnswer_${index}`).is(':checked')) {
                    const text = $(this).val().trim();
                    console.log('Updating RightAns to:', text);
                    $('#RightAns').val(text);
                }
            });
            
            // Initial update
            updateRightAnswer();
            
            // Handle form submission
            $('#createQuestionForm').on('submit', function(e) {
                // Don't prevent default submission - let the browser handle it naturally
                
                // Find selected answer and update RightAns field
                let hasSelectedAnswer = false;
                let hasAnyAnswer = false;
                
                $('.answer-input').each(function(index) {
                    const text = $(this).val().trim();
                    if (text) {
                        hasAnyAnswer = true;
                        if ($(`#rightAnswer_${index}`).is(':checked')) {
                            $('#RightAns').val(text);
                            hasSelectedAnswer = true;
                        }
                    }
                });
                
                // If no answer is selected but we have answers, select the first valid one
                if (!hasSelectedAnswer && hasAnyAnswer) {
                    let firstValidIndex = -1;
                    $('.answer-input').each(function(index) {
                        if ($(this).val().trim() && firstValidIndex === -1) {
                            firstValidIndex = index;
                        }
                    });
                    
                    if (firstValidIndex >= 0) {
                        $(`#rightAnswer_${firstValidIndex}`).prop('checked', true);
                        $('#RightAns').val($(`#Answers_${firstValidIndex}`).val().trim());
                    }
                }
                
                // Basic validation
                if (!hasAnyAnswer) {
                    alert('Please enter at least one answer option.');
                    e.preventDefault(); // Only prevent submission on error
                    return false;
                }
                
                if (!$('#RightAns').val()) {
                    alert('Please select a correct answer.');
                    e.preventDefault(); // Only prevent submission on error
                    return false;
                }
                
                if (!$('#QuestionText').val().trim()) {
                    alert('Please enter a question.');
                    e.preventDefault(); // Only prevent submission on error
                    return false;
                }
                
                // Log form data for debugging
                console.log("Submit form with data:");
                console.log("QuizID:", $('#QuizID').val());
                console.log("QuestionText:", $('#QuestionText').val());
                console.log("Score:", $('#Score').val());
                console.log("RightAns:", $('#RightAns').val());
                
                // Let the form submit naturally - no need to call this.submit()
            });
        });
    </script>
    
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

