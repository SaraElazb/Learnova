@using PresentationLayer.ActionRequests.AccountActionRequest
@model RegisterActionRequest

@{
    ViewData["Title"] = "Register";
    Layout = "_Layout2";
}

@section CustomHeadContent {
    <link rel="stylesheet" href="~/css/login-register.css" />
}

<div class="container">
    <div class="form-container">
        <div class="logo-container">
            <img src="~/assets/logonoslogan.png" alt="LearnNova Logo" class="logo">
        </div>
        <h2>Create an Account</h2>
        <p class="subtitle">Join thousands of users and start learning today!</p>

        <form asp-controller="Account" asp-action="Register" method="post" id="registerForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="FirstName">First Name</label>
                <div class="input-container">
                    <input asp-for="FirstName" class="form-control" required>
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="LastName">Last Name</label>
                <div class="input-container">
                    <input asp-for="LastName" class="form-control" required>
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Username">Username</label>
                <div class="input-container">
                    <input asp-for="Username" class="form-control" required>
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email address</label>
                <div class="input-container">
                    <input asp-for="Email" class="form-control" required>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group role-selection">
                <label>I want to join as</label>
                <div class="radio-group">
                    <div class="radio-option">
                        <input type="radio" asp-for="Role" id="roleStudent" value="Student" checked>
                        <label for="roleStudent">Student</label>
                    </div>
                    <div class="radio-option">
                        <input type="radio" asp-for="Role" id="roleInstructor" value="Instructor">
                        <label for="roleInstructor">Instructor</label>
                    </div>
                </div>
            </div>

            <!-- Student-specific fields -->
            <div class="role-specific-fields student-fields">
                <div class="form-group">
                    <label asp-for="NationalId">National ID (Optional)</label>
                    <div class="input-container">
                        <input asp-for="NationalId" class="form-control">
                        <span asp-validation-for="NationalId" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Grade">Grade/Year (Optional)</label>
                    <div class="input-container">
                        <input asp-for="Grade" class="form-control">
                        <span asp-validation-for="Grade" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Instructor-specific fields -->
            <div class="role-specific-fields instructor-fields hidden">
                <div class="form-group">
                    <label asp-for="Specialization">Specialization</label>
                    <div class="input-container">
                        <input asp-for="Specialization" class="form-control">
                        <span asp-validation-for="Specialization" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="YearsOfExperience">Years of Experience</label>
                    <div class="input-container">
                        <input asp-for="YearsOfExperience" type="number" min="0" class="form-control">
                        <span asp-validation-for="YearsOfExperience" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <div class="input-container">
                    <input asp-for="Password" type="password" class="form-control" required>
                    <button type="button" class="toggle-password" aria-label="Toggle password visibility">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eye">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eye-off hidden">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                            <line x1="1" y1="1" x2="23" y2="23"></line>
                        </svg>
                    </button>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmedPassword">Confirm password</label>
                <div class="input-container">
                    <input asp-for="ConfirmedPassword" type="password" class="form-control" required>
                    <button type="button" class="toggle-password" aria-label="Toggle password visibility">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eye">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eye-off hidden">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                            <line x1="1" y1="1" x2="23" y2="23"></line>
                        </svg>
                    </button>
                    <span asp-validation-for="ConfirmedPassword" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">
                <span class="btn-text">Sign Up</span>
            </button>
        </form>

        <div class="alt-action">
            <p>Already have an account? <a asp-controller="Account" asp-action="LogIn">Log in</a></p>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

@section CustomScripts {
    <script src="~/js/login-register.js"></script>
} 