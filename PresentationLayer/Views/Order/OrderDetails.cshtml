@model BusinessLogicLayer.DTOs.OrderDtos.OrderDto

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4>Order #@Model.OrderId</h4>
                    <span class="badge bg-@(Model.Status == "Completed" ? "success" : "warning")">@Model.Status</span>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h5>Order Information</h5>
                        <p><strong>Date:</strong> @Model.CreatedAt.ToString("g")</p>
                        <p><strong>Status:</strong> @Model.Status</p>
                        <p><strong>Total Amount:</strong> @Model.TotalAmount.ToString("C")</p>
                    </div>

                    <div class="mb-4">
                        <h5>Order Items</h5>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Course</th>
                                    <th>Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>@item.CourseTitle</td>
                                        <td>@item.Price.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th>Total</th>
                                    <th>@Model.TotalAmount.ToString("C")</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    @if (Model.Status == "Completed")
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            An invoice has been sent to your email address.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div> 