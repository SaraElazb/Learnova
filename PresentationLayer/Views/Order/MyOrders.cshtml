@model IEnumerable<BusinessLogicLayer.DTOs.OrderDtos.OrderDto>

<div class="container mt-4">
    <h2>My Orders</h2>
    
    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You haven't placed any orders yet.
            <a href="@Url.Action("Index", "Course")" class="alert-link">Browse courses</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var order in Model.OrderByDescending(o => o.CreatedAt))
            {
                <div class="col-md-6 mb-4">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Order #@order.OrderId</h5>
                            <span class="badge bg-@(order.Status == "Completed" ? "success" : "warning")">@order.Status</span>
                        </div>
                        <div class="card-body">
                            <p><strong>Date:</strong> @order.CreatedAt.ToString("g")</p>
                            <p><strong>Total:</strong> @order.TotalAmount.ToString("C")</p>
                            <p><strong>Items:</strong> @order.Items.Count</p>
                            
                            <div class="mt-3">
                                <a href="@Url.Action("OrderDetails", "Order", new { id = order.OrderId })" 
                                   class="btn btn-primary">View Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div> 