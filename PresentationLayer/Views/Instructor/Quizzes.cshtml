@model IEnumerable<BusinessLogicLayer.DTOs.QuizDtos.QuizDto>
@{
    ViewData["Title"] = "My Quizzes";
    Layout = "_Layout2";
}

@section CustomHeadContent {
    <link rel="stylesheet" href="~/css/instructor-dashboard.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
}

<div class="container dashboard-container">
    <div class="dashboard-header">
        <h1 class="dashboard-title">My Quizzes</h1>
        <div class="dashboard-actions">
            <a href="@Url.Action("Create", "Quiz")" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Create Quiz
            </a>
        </div>
    </div>

    <div class="dashboard-card">
        <div class="dashboard-card-header">
            <h3>Quiz List</h3>
            <div class="actions">
                <a href="@Url.Action("Dashboard", "Instructor")" class="btn">Back to Dashboard</a>
            </div>
        </div>
        <div class="dashboard-card-body">
            <div class="table-responsive">
                <table class="courses-table">
                    <thead>
                        <tr>
                            <th>Quiz Title</th>
                            <th>Lesson</th>
                            <th>Passing Score</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var quiz in Model)
                            {
                                <tr>
                                    <td>@quiz.Title</td>
                                    <td>@quiz.LessonTitle</td>
                                    <td>@quiz.Passing_score</td>
                                    <td>
                                        <div class="table-actions">
                                            <a href="@Url.Action("Edit", "Quiz", new { id = quiz.Quiz_ID })" class="btn-icon edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a href="@Url.Action("Details", "Quiz", new { id = quiz.Quiz_ID })" class="btn-icon view">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a href="@Url.Action("Index", "Question", new { quizId = quiz.Quiz_ID })" class="btn-icon">
                                                <i class="bi bi-list-check"></i>
                                            </a>
                                            <a href="@Url.Action("Delete", "Quiz", new { id = quiz.Quiz_ID })" class="btn-icon delete" onclick="return confirm('Are you sure you want to delete this quiz?')">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center">No quizzes found. <a href="@Url.Action("Create", "Quiz")">Create your first quiz</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section CustomScripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Quizzes page loaded');
        });
    </script>
} 