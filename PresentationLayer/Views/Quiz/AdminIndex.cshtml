@model IEnumerable<BusinessLogicLayer.DTOs.QuizDtos.QuizDto>

@{
    ViewData["Title"] = "Quizzes Management";
}

<div class="container mt-4">
    <h1>Quizzes Management</h1>
    
    <p>
        <a asp-action="Create" class="btn btn-primary">Create New Quiz</a>
    </p>
    
    <div class="table-responsive">
        <table class="table table-bordered table-hover">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Lesson</th>
                    <th>Passing Score</th>
                    <th>Questions</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.LessonTitle</td>
                        <td>@item.Passing_score</td>
                        <td>
                            @if (item.Questions != null)
                            {
                                @item.Questions.Count
                                <a asp-controller="Question" asp-action="Index" asp-route-quizId="@item.Quiz_ID" class="btn btn-sm btn-outline-secondary">Manage</a>
                            }
                            else
                            {
                                <span>0</span>
                                <a asp-controller="Question" asp-action="Create" asp-route-quizId="@item.Quiz_ID" class="btn btn-sm btn-outline-secondary">Add</a>
                            }
                        </td>
                        <td>
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.Quiz_ID" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.Quiz_ID" class="btn btn-sm btn-outline-info">Details</a>
                                <a asp-action="Delete" asp-route-id="@item.Quiz_ID" class="btn btn-sm btn-outline-danger" 
                                   onclick="return confirm('Are you sure you want to delete this quiz?');">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div> 