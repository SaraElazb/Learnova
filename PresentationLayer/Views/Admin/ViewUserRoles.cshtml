@using PresentationLayer.VMs.UserRolesVms
@model List<UserRoleVm>
@{
    ViewData["Title"] = "Manage User Roles";
    var allRoles = ViewBag.AllRoles as List<string>;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string searchTerm = ViewBag.SearchTerm as string ?? "";
    Layout = "_AdminLayout";
}

<div class="content-header">
    <h1 class="content-title">User Role Management</h1>
    <p class="content-subtitle">Manage user roles across your e-learning platform</p>
</div>

<!-- Search Form -->
<div class="search-form">
    <form asp-action="ViewUserRoles" method="get">
        <div class="search-input-container">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="M11 19C15.4183 19 19 15.4183 19 11C19 6.58172 15.4183 3 11 3C6.58172 3 3 6.58172 3 11C3 15.4183 6.58172 19 11 19Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <input type="text" name="searchTerm" value="@searchTerm" class="search-input" 
                   placeholder="Search by username or email..." />
        </div>
        <button type="submit" class="search-button">Search</button>
    </form>
</div>

<!-- User Roles Grid -->
<div class="user-roles-grid">
    @if (Model != null && Model.Any())
    {
        foreach (var user in Model)
        {
            <div class="user-role-card">
                <div class="user-role-header">
                    <div class="user-info">
                        <span class="user-name">@user.UserName</span>
                        <span class="user-email">@user.Email</span>
                    </div>
                    <span class="user-id">ID: @user.UserId.Substring(0, 8)...</span>
                </div>
                <div class="user-role-body">
                    <div class="current-roles">
                        <h3>Current Roles</h3>
                        <div class="role-badges">
                            @if (user.Roles.Any())
                            {
                                foreach (var role in user.Roles)
                                {
                                    string roleClass = role.ToLower();
                                    <span class="role-badge @roleClass">@role</span>
                                }
                            }
                            else
                            {
                                <span class="role-badge none">No roles</span>
                            }
                        </div>
                    </div>

                    <form asp-action="UpdateUserRoles" method="post" class="update-roles-form">
                        <input type="hidden" name="UserId" value="@user.UserId" />

                        <h3>Modify Roles</h3>
                        <div class="role-checkboxes">
                            @foreach (var role in allRoles)
                            {
                                var isChecked = user.Roles.Contains(role);
                                var checkboxId = $"{user.UserId}_{role}";

                                <div class="role-checkbox-wrapper">
                                    <input class="role-checkbox" type="checkbox"
                                        name="SelectedRoles"
                                        value="@role"
                                        id="@checkboxId"
                                        @(isChecked ? "checked" : "") />
                                    <label class="role-checkbox-label" for="@checkboxId">
                                        @role
                                    </label>
                                </div>
                            }
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="update-button">Update Roles</button>
                        </div>
                    </form>
                    
                    <div class="delete-user-section">
                        <h3>Delete User</h3>
                        <p class="delete-warning">This action cannot be undone.</p>
                        <div class="form-actions">
                            <button type="button" class="delete-button" onclick="checkUserDeletion('@user.UserId')">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                                    <path d="M3 6H5H21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M8 6V4C8 3.46957 8.21071 2.96086 8.58579 2.58579C8.96086 2.21071 9.46957 2 10 2H14C14.5304 2 15.0391 2.21071 15.4142 2.58579C15.7893 2.96086 16 3.46957 16 4V6M19 6V20C19 20.5304 18.7893 21.0391 18.4142 21.4142C18.0391 21.7893 17.5304 22 17 22H7C6.46957 22 5.96086 21.7893 5.58579 21.4142C5.21071 21.0391 5 20.5304 5 20V6H19Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                Delete User
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none">
                <path d="M11 19C15.4183 19 19 15.4183 19 11C19 6.58172 15.4183 3 11 3C6.58172 3 3 6.58172 3 11C3 15.4183 6.58172 19 11 19Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <h3>No users found</h3>
            <p>Try modifying your search criteria or add new users to the system.</p>
        </div>
    }
</div>

<!-- Confirmation Modal -->
<div id="deleteModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <span class="modal-title">Delete User</span>
            <span class="close-modal">&times;</span>
        </div>
        <div class="modal-body">
            <div id="userInfo"></div>
            <div id="associatedDataWarning" class="warning-message"></div>
        </div>
        <div class="modal-footer">
            <button type="button" class="cancel-button">Cancel</button>
            <form id="deleteUserForm" asp-action="DeleteUser" method="post">
                <input type="hidden" id="deleteUserId" name="UserId" value="" />
                <button type="submit" class="confirm-delete-button">Delete</button>
            </form>
        </div>
    </div>
</div>

<!-- Pagination -->
@if (totalPages > 1)
{
    <div class="pagination-container">
        <div class="pagination">
            @if (currentPage > 1)
            {
                <a class="pagination-item" asp-action="ViewUserRoles" asp-route-searchTerm="@searchTerm" asp-route-page="@(currentPage - 1)">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
            }

            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
            {
                <a class="pagination-item @(i == currentPage ? "active" : "")" asp-action="ViewUserRoles" asp-route-searchTerm="@searchTerm" asp-route-page="@i">@i</a>
            }

            @if (currentPage < totalPages)
            {
                <a class="pagination-item" asp-action="ViewUserRoles" asp-route-searchTerm="@searchTerm" asp-route-page="@(currentPage + 1)">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
            }
        </div>
    </div>
}

@section CustomScripts {
    <script>
        function checkUserDeletion(userId) {
            fetch(`/Admin/CheckUserDeletionStatus?userId=${userId}`)
                .then(response => response.json())
                .then(data => {
                    const modal = document.getElementById('deleteModal');
                    const userInfoElement = document.getElementById('userInfo');
                    const warningElement = document.getElementById('associatedDataWarning');
                    const deleteForm = document.getElementById('deleteUserForm');
                    const deleteUserIdInput = document.getElementById('deleteUserId');
                    const confirmDeleteButton = document.querySelector('.confirm-delete-button');
                    
                    // Set user ID in form
                    deleteUserIdInput.value = userId;
                    
                    // Show user info
                    userInfoElement.innerHTML = `<p>Are you sure you want to delete user <strong>${data.username}</strong> (${data.email})?</p>`;
                    
                    // Check if user can be deleted
                    if (!data.canDelete) {
                        warningElement.innerHTML = `
                            <p>This user cannot be deleted because they have the following associated data:</p>
                            <ul>
                                ${data.associatedData.map(item => `<li>${item}</li>`).join('')}
                            </ul>
                            <p>You must remove or reassign this content before deleting the user.</p>
                        `;
                        confirmDeleteButton.disabled = true;
                        confirmDeleteButton.classList.add('disabled');
                    } else {
                        warningElement.innerHTML = '';
                        confirmDeleteButton.disabled = false;
                        confirmDeleteButton.classList.remove('disabled');
                    }
                    
                    // Show modal
                    modal.style.display = 'flex';
                })
                .catch(error => {
                    console.error('Error checking user deletion status:', error);
                    alert('An error occurred while checking if the user can be deleted.');
                });
        }
        
        // Close modal when clicking the X or Cancel button
        document.querySelector('.close-modal').addEventListener('click', function() {
            document.getElementById('deleteModal').style.display = 'none';
        });
        
        document.querySelector('.cancel-button').addEventListener('click', function() {
            document.getElementById('deleteModal').style.display = 'none';
        });
        
        // Close modal when clicking outside of it
        window.addEventListener('click', function(event) {
            const modal = document.getElementById('deleteModal');
            if (event.target === modal) {
                modal.style.display = 'none';
            }
        });
    </script>
}
