@using PresentationLayer.VMs.UserRolesVms
@model List<UserRoleVm>
@{
    ViewData["Title"] = "Manage User Roles";
    var allRoles = ViewBag.AllRoles as List<string>;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string searchTerm = ViewBag.SearchTerm as string ?? "";
}

<h2 class="mb-4 text-center text-primary">Manage User Roles</h2>

<!-- Search Form -->
<form asp-action="ViewUserRoles" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="searchTerm" value="@searchTerm" class="form-control" placeholder="Search by username or email" />
        <button type="submit" class="btn btn-outline-primary">Search</button>
    </div>
</form>

<!-- User Roles Table -->
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="thead-light">
            <tr>
                <th>User Name</th>
                <th>Current Roles</th>
                <th>Assign / Remove Roles</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>
                        @if (user.Roles.Any())
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var role in user.Roles)
                                {
                                    <span class="badge bg-success">@role</span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No roles</span>
                        }
                    </td>
                    <td>
                        <form asp-action="UpdateUserRoles" method="post" class="d-flex flex-wrap gap-3 align-items-center">
                            <input type="hidden" name="UserId" value="@user.UserId" />

                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var role in allRoles)
                                {
                                    var isChecked = user.Roles.Contains(role);
                                    var checkboxId = $"{user.UserId}_{role}";

                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox"
                                               name="SelectedRoles"
                                               value="@role"
                                               id="@checkboxId"
                                        @(isChecked ? "checked" : "") />
                                        <label class="form-check-label" for="@checkboxId">
                                            @role
                                        </label>
                                    </div>
                                }
                            </div>

                            <div>
                                <button type="submit" class="btn btn-outline-success btn-sm mt-2">Update Roles</button>
                            </div>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
@if (totalPages > 1)
{
    <nav aria-label="User pagination">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="ViewUserRoles" asp-route-searchTerm="@searchTerm" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
