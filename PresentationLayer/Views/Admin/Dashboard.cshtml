@using Microsoft.AspNetCore.Mvc.TagHelpers
@model List<BusinessLogicLayer.DTOs.UserRolesDtos.UserRolesDto>
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
    var totalStudents = ViewBag.TotalStudents ?? 0;
    var totalInstructors = ViewBag.TotalInstructors ?? 0;
    var totalUsers = ViewBag.TotalUsers ?? 0;
    var totalCourses = ViewBag.TotalCourses ?? 0;
}

@functions {
    public string GetAvatarUrl(string userName)
    {
        if (string.IsNullOrEmpty(userName))
            return "https://ui-avatars.com/api/?name=User&background=10B981&color=ffffff";
            
        // Get the first letter of each word in the name and combine them
        string initials = string.Join("", userName.Split(' ')
            .Where(n => !string.IsNullOrEmpty(n))
            .Select(n => n[0].ToString().ToUpper()));
            
        // Limit to 2 characters if there are more
        if (initials.Length > 2)
            initials = initials.Substring(0, 2);
            
        // Generate placeholder avatar URL with user's initials
        return $"https://ui-avatars.com/api/?name={initials}&background=10B981&color=ffffff";
    }
}

<style>
    .admin-dashboard-content {
        padding: 0;
    }
    
    .welcome-section {
        background: linear-gradient(135deg, var(--layout-color-primary), var(--layout-color-secondary));
        padding: 2rem;
        border-radius: var(--layout-border-radius-lg);
        margin-bottom: 2rem;
        color: white;
        position: relative;
        overflow: hidden;
        box-shadow: var(--layout-shadow-md);
    }
    
    .welcome-section::before {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 70%);
        border-radius: 50%;
        transform: translate(30%, -30%);
    }
    
    .welcome-title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }
    
    .welcome-subtitle {
        font-size: 1.1rem;
        opacity: 0.9;
        max-width: 600px;
    }
    
    .quick-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 1.5rem;
    }
    
    .quick-action-btn {
        background-color: rgba(255, 255, 255, 0.15);
        color: white;
        border: none;
        padding: 0.6rem 1.2rem;
        border-radius: var(--layout-border-radius-md);
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        text-decoration: none;
    }
    
    .quick-action-btn:hover {
        background-color: rgba(255, 255, 255, 0.25);
        transform: translateY(-2px);
        color: white;
    }
    
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }
    
    .stat-card {
        background-color: var(--layout-color-card-bg);
        border-radius: var(--layout-border-radius-lg);
        padding: 1.5rem;
        box-shadow: var(--layout-shadow-sm);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    
    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--layout-shadow-md);
    }
    
    .stat-content {
        flex: 1;
    }
    
    .stat-title {
        font-size: 0.9rem;
        color: var(--layout-color-text-light);
        margin-bottom: 0.5rem;
    }
    
    .stat-value {
        font-size: 2rem;
        font-weight: 700;
        color: var(--layout-color-text);
    }
    
    .stat-change {
        font-size: 0.8rem;
        color: var(--layout-color-text-light);
        display: flex;
        align-items: center;
        gap: 0.25rem;
        margin-top: 0.25rem;
    }
    
    .stat-change.positive {
        color: var(--layout-color-success);
    }
    
    .stat-change.negative {
        color: var(--layout-color-error);
    }
    
    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: rgba(255, 255, 255, 0.1);
    }
    
    .users-icon {
        background-color: rgba(59, 130, 246, 0.15);
        color: #3B82F6;
    }
    
    .students-icon {
        background-color: rgba(16, 185, 129, 0.15);
        color: #10B981;
    }
    
    .teachers-icon {
        background-color: rgba(139, 92, 246, 0.15);
        color: #8B5CF6;
    }
    
    .courses-icon {
        background-color: rgba(245, 158, 11, 0.15);
        color: #F59E0B;
    }
    
    .card-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1.5rem;
    }
    
    .dashboard-card {
        background-color: var(--layout-color-card-bg);
        border-radius: var(--layout-border-radius-lg);
        box-shadow: var(--layout-shadow-sm);
        overflow: hidden;
    }
    
    .dashboard-card-header {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .dashboard-card-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--layout-color-text);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .dashboard-card-body {
        padding: 1.5rem;
    }
    
    .view-all {
        color: var(--layout-color-primary);
        font-size: 0.9rem;
        font-weight: 500;
        transition: color 0.2s ease;
    }
    
    .view-all:hover {
        color: var(--layout-color-primary-hover);
    }
    
    .recent-users {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    
    .user-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        border-radius: var(--layout-border-radius-md);
        transition: background-color 0.2s ease;
    }
    
    .user-item:hover {
        background-color: rgba(255, 255, 255, 0.05);
    }
    
    .user-avatar {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        object-fit: cover;
    }
    
    .user-details {
        flex: 1;
    }
    
    .user-name {
        font-weight: 600;
        color: var(--layout-color-text);
        margin-bottom: 0.25rem;
    }
    
    .user-email {
        color: var(--layout-color-text-light);
        font-size: 0.85rem;
    }
    
    .user-role {
        padding: 0.25rem 0.75rem;
        border-radius: 2rem;
        font-size: 0.75rem;
        font-weight: 600;
    }
    
    .role-admin {
        background-color: rgba(239, 68, 68, 0.15);
        color: #EF4444;
    }
    
    .role-teacher {
        background-color: rgba(139, 92, 246, 0.15);
        color: #8B5CF6;
    }
    
    .role-student {
        background-color: rgba(16, 185, 129, 0.15);
        color: #10B981;
    }
    
    .quick-stats {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }
    
    .quick-stat {
        background-color: rgba(255, 255, 255, 0.05);
        padding: 1rem;
        border-radius: var(--layout-border-radius-md);
        text-align: center;
    }
    
    .quick-stat-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--layout-color-text);
        margin-bottom: 0.25rem;
    }
    
    .quick-stat-label {
        color: var(--layout-color-text-light);
        font-size: 0.85rem;
    }
    
    @@media (max-width: 1024px) {
        .card-grid {
            grid-template-columns: 1fr;
        }
    }
    
    @@media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        }
        
        .welcome-section {
            padding: 1.5rem;
        }
        
        .welcome-title {
            font-size: 1.5rem;
        }
    }
    
    .form-actions {
        display: flex;
        justify-content: flex-end;
    }
    
    .quick-links {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
    
    .quick-link-item {
        padding: 0.85rem;
        background-color: rgba(255, 255, 255, 0.05);
        border-radius: var(--layout-border-radius-md);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: var(--layout-color-text);
        transition: all 0.3s ease;
    }
    
    .quick-link-item:hover {
        background-color: rgba(255, 255, 255, 0.1);
        transform: translateY(-2px);
    }
    
    .quick-link-item svg {
        color: var(--layout-color-primary);
    }
    
    .recent-users {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    
    .user-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem;
        border-radius: var(--layout-border-radius-md);
        transition: background-color 0.3s ease;
    }
    
    .user-item:hover {
        background-color: rgba(255, 255, 255, 0.05);
    }
    
    .user-avatar-sm {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        overflow: hidden;
    }
    
    .user-avatar-sm img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .user-info-sm {
        flex: 1;
    }
    
    .user-name-sm {
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--layout-color-text);
        margin-bottom: 0.1rem;
    }
    
    .user-roles-sm {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
    }
    
    .user-role-badge-sm {
        font-size: 0.7rem;
        padding: 0.15rem 0.5rem;
        border-radius: 9999px;
        background-color: rgba(255, 255, 255, 0.1);
        color: var(--layout-color-text-light);
    }
</style>

<div class="admin-dashboard-content">
    <section class="welcome-section">
        <h1 class="welcome-title">Welcome back, Admin!</h1>
        <p class="welcome-subtitle">Here's an overview of your e-learning platform statistics.</p>
        
        <div class="quick-actions">
            <a asp-controller="Course" asp-action="AdminIndex" class="quick-action-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M12 6.25V19.25" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M12 6.25C10.83 5.48 9.25 5 7.5 5C5.75 5 4.17 5.48 3 6.25V19.25C4.17 18.48 5.75 18 7.5 18C9.25 18 10.83 18.48 12 19.25" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Manage Courses
            </a>
            <a asp-controller="Category" asp-action="Index" class="quick-action-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M4 7V5C4 4.44772 4.44772 4 5 4H9C9.55228 4 10 4.44772 10 5V7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M5 7H4C3.44772 7 3 7.44772 3 8V17C3 17.5523 3.44772 18 4 18H20C20.5523 18 21 17.5523 21 17V12C21 11.4477 20.5523 11 20 11H11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Manage Categories
            </a>
            <a asp-controller="Admin" asp-action="ViewUserRoles" class="quick-action-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M17 21V19C17 17.94 16.58 16.92 15.83 16.17C15.08 15.42 14.06 15 13 15H5C3.94 15 2.92 15.42 2.17 16.17C1.42 16.92 1 17.94 1 19V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M9 11C11.21 11 13 9.21 13 7C13 4.79 11.21 3 9 3C6.79 3 5 4.79 5 7C5 9.21 6.79 11 9 11Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Manage Users
            </a>
        </div>
    </section>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-content">
                <div class="stat-title">Total Users</div>
                <div class="stat-value">@totalUsers</div>
            </div>
            <div class="stat-icon users-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path d="M17 21V19C17 17.94 16.58 16.92 15.83 16.17C15.08 15.42 14.06 15 13 15H5C3.94 15 2.92 15.42 2.17 16.17C1.42 16.92 1 17.94 1 19V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M9 11C11.21 11 13 9.21 13 7C13 4.79 11.21 3 9 3C6.79 3 5 4.79 5 7C5 9.21 6.79 11 9 11Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M23 21V19C22.99 18.11 22.70 17.24 22.16 16.55C21.62 15.85 20.86 15.35 20 15.13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M16 3.13C16.86 3.35 17.62 3.85 18.17 4.55C18.71 5.25 19.01 6.11 19.01 7.00C19.01 7.88 18.71 8.75 18.17 9.45C17.62 10.15 16.86 10.65 16 10.87" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-content">
                <div class="stat-title">Total Students</div>
                <div class="stat-value">@totalStudents</div>
            </div>
            <div class="stat-icon students-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path d="M17 21V19C17 17.94 16.58 16.92 15.83 16.17C15.08 15.42 14.06 15 13 15H5C3.94 15 2.92 15.42 2.17 16.17C1.42 16.92 1 17.94 1 19V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M9 11C11.21 11 13 9.21 13 7C13 4.79 11.21 3 9 3C6.79 3 5 4.79 5 7C5 9.21 6.79 11 9 11Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-content">
                <div class="stat-title">Total Instructors</div>
                <div class="stat-value">@totalInstructors</div>
                    </div>
            <div class="stat-icon teachers-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path d="M12 12H14C15.1 12 16 11.1 16 10V6C16 4.9 15.1 4 14 4H12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M12 4V20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M12 16H14C15.1 16 16 16.9 16 18V20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M12 12H10C8.9 12 8 11.1 8 10V6C8 4.9 8.9 4 10 4H12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M12 16H10C8.9 16 8 16.9 8 18V20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </div>
                            </div>

        <div class="stat-card">
            <div class="stat-content">
                <div class="stat-title">Total Courses</div>
                <div class="stat-value">@totalCourses</div>
            </div>
            <div class="stat-icon courses-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path d="M12 6.25V19.25" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M12 6.25C10.83 5.48 9.25 5 7.5 5C5.75 5 4.17 5.48 3 6.25V19.25C4.17 18.48 5.75 18 7.5 18C9.25 18 10.83 18.48 12 19.25" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M12 6.25C13.17 5.48 14.75 5 16.5 5C18.25 5 19.83 5.48 21 6.25V19.25C19.83 18.48 18.25 18 16.5 18C14.75 18 13.17 18.48 12 19.25" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                                    </div>
                                </div>
                            </div>

    <div class="dashboard-card">
        <div class="dashboard-card-header">
            <h2 class="dashboard-card-title">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M17 21V19C17 17.94 16.58 16.92 15.83 16.17C15.08 15.42 14.06 15 13 15H5C3.94 15 2.92 15.42 2.17 16.17C1.42 16.92 1 17.94 1 19V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M9 11C11.21 11 13 9.21 13 7C13 4.79 11.21 3 9 3C6.79 3 5 4.79 5 7C5 9.21 6.79 11 9 11Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                Recent Users
            </h2>
            <a asp-controller="Admin" asp-action="ViewUserRoles" class="view-all">View All</a>
                                    </div>
        <div class="dashboard-card-body">
            <div class="recent-users">
                @if (Model != null && Model.Any())
                {
                    foreach (var user in Model.Take(5))
                    {
                        var roleClass = user.Roles.Contains("Admin") ? "role-admin" : 
                                      user.Roles.Contains("Teacher") ? "role-teacher" : "role-student";
                        var roleName = user.Roles.FirstOrDefault() ?? "No Role";
                        
                        <div class="user-item">
                            <img src="@GetAvatarUrl(user.UserName)" alt="@user.UserName" class="user-avatar" />
                            <div class="user-details">
                                <div class="user-name">@user.UserName</div>
                                <div class="user-email">@user.Email</div>
                            </div>
                            <span class="user-role @roleClass">@roleName</span>
                        </div>
                    }
                }
                else
                {
                    <p class="text-center text-muted my-4">No users found</p>
                }
                </div>
            </div>
        </div>
    </div>

@section CustomScripts {
        <script src="~/js/admin-dashboard.js"></script>
}

