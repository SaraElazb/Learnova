@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "_Layout2";
    
    var enrolledCourses = ViewBag.EnrolledCourses as IEnumerable<BusinessLogicLayer.DTOs.CourseDtos.CourseDTO>;
    var assignments = ViewBag.UpcomingAssignments as IEnumerable<BusinessLogicLayer.Services.StudentServices.AssignmentDto>;
    var activities = ViewBag.RecentActivities as IEnumerable<BusinessLogicLayer.Services.StudentServices.ActivityDto>;
    var overallProgress = ViewBag.OverallProgress as int? ?? 0;
    var courseProgress = ViewBag.CourseProgress as Dictionary<string, int> ?? new Dictionary<string, int>();
}

<link rel="stylesheet" href="~/css/student-dashboard.css" />

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="container">
            <div class="welcome-message">
                <h1>Welcome, @User.Identity.Name!</h1>
                <p>Continue learning and tracking your progress on your courses</p>
            </div>
        </div>
    </div>

    <div class="container mt-4">
        <div class="dashboard-stats mb-4">
            <div class="row">
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-card-body">
                            <div class="stat-card-icon">
                                <i class="bi bi-book"></i>
                            </div>
                            <div class="stat-card-info">
                                <h2>@(enrolledCourses?.Count() ?? 0)</h2>
                                <p>Enrolled Courses</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-card-body">
                            <div class="stat-card-icon bg-success">
                                <i class="bi bi-check-circle"></i>
                            </div>
                            <div class="stat-card-info">
                                <h2>@overallProgress%</h2>
                                <p>Overall Progress</p>
                            </div>
                        </div>
                    </div>
                </div>
            
              
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <div class="card mb-4 dashboard-card">
                    <div class="card-header">
                        <h4><i class="bi bi-book me-2"></i>My Enrolled Courses</h4>
                    </div>
                    <div class="card-body"> 
                        <div class="row">
                            @if (enrolledCourses != null && enrolledCourses.Any())
                            {
                                @foreach (var course in enrolledCourses)
                                {
                                    <div class="col-md-6 mb-4">
                                        <div class="card h-100 course-card">
                                            @if (!string.IsNullOrEmpty(course.ThumbnailUrl))
                                            {
                                                <div class="course-thumbnail">
                                                    <img src="@course.ThumbnailUrl" alt="@course.Title" />
                                                    <div class="course-badge @(course.Progress == 100 ? "badge-completed" : "badge-progress")">
                                                        @(course.Progress == 100 ? "Completed" : "In Progress")
                                                    </div>
                                                </div>
                                            }
                                            <div class="card-body">
                                                <div class="course-category">@course.Category</div>
                                                <h5 class="card-title">@course.Title</h5>
                                                <p class="card-text">@(string.IsNullOrEmpty(course.Description) ? "No description available" : 
                                                    (course.Description.Length > 80 ? course.Description.Substring(0, 80) + "..." : course.Description))</p>
                                                <div class="progress-container">
                                                    <div class="progress-label">
                                                        <span>Progress</span>
                                                        <span>@course.Progress%</span>
                                                    </div>
                                                    <div class="progress mb-2" style="height: 5px;">
                                                        <div class="progress-bar @(course.Progress == 100 ? "bg-primary" : "bg-success")" 
                                                             role="progressbar" 
                                                             style="width: @course.Progress%;" 
                                                             aria-valuenow="@course.Progress" 
                                                             aria-valuemin="0" 
                                                             aria-valuemax="100"></div>
                                                    </div>
                                                </div>
                                                <div class="course-meta">
                                                    <div><i class="bi bi-book me-1"></i> @course.LessonCount lessons</div>
                                                    <div><i class="bi bi-calendar me-1"></i> Enrolled: @course.EnrollmentDate?.ToString("MMM dd, yyyy")</div>
                                                </div>
                                            </div>
                                            <div class="card-footer bg-transparent">
                                                <a href="/Course/Details/@course.Course_ID" class="btn btn-outline-primary btn-continue">
                                                    <i class="bi @(course.Progress == 100 ? "bi-eye" : "bi-play-fill")"></i>
                                                    @(course.Progress == 100 ? "Review Course" : "Continue Learning")
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="col-12">
                                    <div class="empty-state">
                                        <div class="empty-state-icon">
                                            <i class="bi bi-book"></i>
                                        </div>
                                        <h4>No Courses Yet</h4>
                                        <p>You haven't enrolled in any courses yet.</p>
                                        <a href="/Course/UserIndex" class="btn btn-primary mt-2">Browse Courses</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>

            <div class="col-md-4">
                <div class="card mb-4 dashboard-card">
                    <div class="card-header">
                        <h4><i class="bi bi-graph-up me-2"></i>My Progress</h4>
                    </div>
                    <div class="card-body">
                        <div class="progress-overview">
                            <div class="progress-circle-container">
                                <div class="progress-circle" style="--progress-value: @overallProgress">
                                    <div class="progress-circle-inner">
                                        <span class="progress-value">@overallProgress%</span>
                                    </div>
                                </div>
                            </div>
                            <h5>Overall Progress</h5>
                        </div>
                        
                        @if (courseProgress != null && courseProgress.Any())
                        {
                            <div class="course-progress-list">
                                @foreach (var course in courseProgress)
                                {
                                    <div class="course-progress-item">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="course-name">@course.Key</span>
                                            <span class="course-percentage">@course.Value%</span>
                                        </div>
                                        <div class="progress" style="height: 5px;">
                                            <div class="progress-bar @(course.Value == 100 ? "bg-primary" : "bg-success")" 
                                                 role="progressbar" 
                                                 style="width: @course.Value%;" 
                                                 aria-valuenow="@course.Value" 
                                                 aria-valuemin="0" 
                                                 aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-state small">
                                <div class="empty-state-icon">
                                    <i class="bi bi-graph-up"></i>
                                </div>
                                <h4>No Progress Data</h4>
                                <p>Start learning to track your progress.</p>
                            </div>
                        }
                    </div>
                </div>

        
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Fade in animation for dashboard elements
            $('.dashboard-stats').addClass('fade-in');
            $('.dashboard-card').each(function(index) {
                var card = $(this);
                setTimeout(function() {
                    card.addClass('fade-in');
                }, index * 100);
            });
        });
    </script>
} 