@{
    ViewData["Title"] = "Student Dashboard";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12 mb-4">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h2>Student Dashboard</h2>
                </div>
                <div class="card-body">
                    <h4>Welcome, @User.Identity.Name!</h4>
                    <p>From here you can access your enrolled courses, assignments, and track your progress.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h4>My Enrolled Courses</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- Course Cards - In a real implementation these would be populated from the model -->
                        <div class="col-md-6 mb-4">
                            <div class="card h-100 border-success">
                                <div class="card-header bg-light">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span>Programming</span>
                                        <span class="badge bg-success">In Progress</span>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title">Introduction to C#</h5>
                                    <p class="card-text">Learn the fundamentals of C# programming language.</p>
                                    <div class="progress mb-3" style="height: 5px;">
                                        <div class="progress-bar bg-success" role="progressbar" style="width: 65%;" aria-valuenow="65" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <small class="text-muted">65% Complete</small>
                                </div>
                                <div class="card-footer bg-transparent">
                                    <div class="d-grid">
                                        <a href="#" class="btn btn-outline-success">Continue Learning</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-6 mb-4">
                            <div class="card h-100 border-success">
                                <div class="card-header bg-light">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span>Web</span>
                                        <span class="badge bg-success">In Progress</span>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title">Advanced Web Development</h5>
                                    <p class="card-text">Master modern web development techniques.</p>
                                    <div class="progress mb-3" style="height: 5px;">
                                        <div class="progress-bar bg-success" role="progressbar" style="width: 30%;" aria-valuenow="30" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <small class="text-muted">30% Complete</small>
                                </div>
                                <div class="card-footer bg-transparent">
                                    <div class="d-grid">
                                        <a href="#" class="btn btn-outline-success">Continue Learning</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-6 mb-4">
                            <div class="card h-100 border-secondary">
                                <div class="card-header bg-light">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span>Database</span>
                                        <span class="badge bg-secondary">Not Started</span>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title">Database Design</h5>
                                    <p class="card-text">Learn database design principles and implementation.</p>
                                    <div class="progress mb-3" style="height: 5px;">
                                        <div class="progress-bar bg-secondary" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <small class="text-muted">0% Complete</small>
                                </div>
                                <div class="card-footer bg-transparent">
                                    <div class="d-grid">
                                        <a href="#" class="btn btn-outline-secondary">Start Learning</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h4>Upcoming Assignments</h4>
                </div>
                <div class="card-body">
                    <ul class="list-group">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1">C# Exercise: Object-Oriented Programming</h6>
                                <small class="text-muted">Introduction to C#</small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-danger">Due: Tomorrow</span>
                                <a href="#" class="btn btn-sm btn-outline-primary ms-2">View</a>
                            </div>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1">Web Project: Responsive Design</h6>
                                <small class="text-muted">Advanced Web Development</small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-warning text-dark">Due: 3 days</span>
                                <a href="#" class="btn btn-sm btn-outline-primary ms-2">View</a>
                            </div>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1">Quiz: JavaScript Fundamentals</h6>
                                <small class="text-muted">Advanced Web Development</small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-info">Due: 1 week</span>
                                <a href="#" class="btn btn-sm btn-outline-primary ms-2">View</a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h4>My Progress</h4>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <div class="progress-circle mx-auto" data-value="42">
                            <span class="progress-circle-text">42%</span>
                        </div>
                        <h5 class="mt-3">Overall Progress</h5>
                    </div>
                    
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item px-0">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span>Introduction to C#</span>
                                <span>65%</span>
                            </div>
                            <div class="progress" style="height: 5px;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: 65%;" aria-valuenow="65" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </li>
                        <li class="list-group-item px-0">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span>Advanced Web Development</span>
                                <span>30%</span>
                            </div>
                            <div class="progress" style="height: 5px;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: 30%;" aria-valuenow="30" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </li>
                        <li class="list-group-item px-0">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span>Database Design</span>
                                <span>0%</span>
                            </div>
                            <div class="progress" style="height: 5px;">
                                <div class="progress-bar bg-secondary" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h4>Recent Activities</h4>
                </div>
                <div class="card-body">
                    <ul class="list-group">
                        <li class="list-group-item border-0 ps-0">
                            <div class="d-flex">
                                <div class="flex-shrink-0">
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                </div>
                                <div class="ms-3">
                                    <p class="mb-0">Completed lesson: Variables & Data Types</p>
                                    <small class="text-muted">Yesterday</small>
                                </div>
                            </div>
                        </li>
                        <li class="list-group-item border-0 ps-0">
                            <div class="d-flex">
                                <div class="flex-shrink-0">
                                    <i class="bi bi-file-earmark-check text-primary fs-5"></i>
                                </div>
                                <div class="ms-3">
                                    <p class="mb-0">Submitted assignment: HTML/CSS Layout</p>
                                    <small class="text-muted">2 days ago</small>
                                </div>
                            </div>
                        </li>
                        <li class="list-group-item border-0 ps-0">
                            <div class="d-flex">
                                <div class="flex-shrink-0">
                                    <i class="bi bi-mortarboard-fill text-info fs-5"></i>
                                </div>
                                <div class="ms-3">
                                    <p class="mb-0">Enrolled in course: Database Design</p>
                                    <small class="text-muted">3 days ago</small>
                                </div>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        /* Custom styles for circular progress */
        .progress-circle {
            position: relative;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: #f2f2f2;
        }
        .progress-circle::before {
            content: '';
            position: absolute;
            top: 10px;
            left: 10px;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: white;
        }
        .progress-circle-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 1.5rem;
            font-weight: bold;
            color: #28a745;
        }
        .progress-circle[data-value="42"]::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: conic-gradient(#28a745 0% 42%, transparent 42% 100%);
        }
    </style>
    <script>
        $(document).ready(function() {
            // This would be enhanced with AJAX calls to load real data in a production implementation
        });
    </script>
} 