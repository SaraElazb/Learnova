@{
    Layout = "_Layout2";
    ViewData["Title"] = "Payment Failed";
}

<div class="payment-error-page">
    <div class="layout-container mt-5 pt-5">
        <div class="payment-error-card">
            <div class="payment-error-icon">
                <i class="bi bi-exclamation-circle-fill"></i>
            </div>
            <h2 class="payment-error-title">Payment Failed</h2>
            <p class="payment-error-message">@ViewBag.Error</p>
            
            <div class="payment-error-details">
                <h3>What might have happened?</h3>
                <ul>
                    <li>Your card might have insufficient funds</li>
                    <li>The payment information provided might be incorrect</li>
                    <li>Your bank might have declined the transaction</li>
                    <li>There might be a temporary issue with our payment processor</li>
                </ul>
            </div>
            
            <div class="payment-error-actions">
                <a href="javascript:history.back()" class="layout-btn layout-btn-primary">
                    <i class="bi bi-arrow-repeat mr-2"></i> Try Again
                </a>
                <a href="@Url.Action("Index", "Home")" class="layout-btn layout-btn-outline">
                    <i class="bi bi-house-door mr-2"></i> Return to Home
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .payment-error-page {
        padding-top: 80px;
        padding-bottom: 120px;
        min-height: calc(100vh - 200px);
        background-color: #f9fafb;
        height: 100vh;
        margin-top: 80px;
    }
    
    .payment-error-card {
        background-color: white;
        border-radius: 0.5rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        padding: 3rem 2.5rem;
        max-width: 700px;
        margin: 2.5rem auto 3rem;
        text-align: center;
    }
    
    .payment-error-icon {
        font-size: 5rem;
        color: #ef4444;
        margin-bottom: 1.5rem;
    }
    
    .payment-error-title {
        color: #1A1F2C;
        margin-bottom: 1rem;
        font-size: 2rem;
    }
    
    .payment-error-message {
        color: #ef4444;
        font-size: 1.125rem;
        margin-bottom: 1.5rem;
        font-weight: 500;
        padding: 1rem 1.5rem;
        background-color: rgba(239, 68, 68, 0.1);
        border-radius: 0.5rem;
        display: inline-block;
    }
    
    .payment-error-details {
        text-align: left;
        margin-bottom: 2rem;
        background-color: #f8f9fa;
        padding: 1.5rem;
        border-radius: 0.5rem;
    }
    
    .payment-error-details h3 {
        color: #1A1F2C;
        margin-bottom: 0.75rem;
        font-size: 1.25rem;
    }
    
    .payment-error-details ul {
        list-style-type: disc;
        padding-left: 1.5rem;
        color: #4b5563;
    }
    
    .payment-error-details li {
        margin-bottom: 0.5rem;
    }
    
    .payment-error-actions {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-top: 1.5rem;
    }
    
    .payment-error-actions .layout-btn {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
    }
    
    @@media (max-width: 768px) {
        .payment-error-card {
            padding: 1.75rem;
            margin: 1.5rem 1rem 3rem;
        }
        
        .payment-error-actions {
            flex-direction: column;
        }
        
        .payment-error-title {
            font-size: 1.75rem;
        }
        
        .payment-error-message {
            font-size: 1rem;
            padding: 0.75rem 1rem;
        }
    }
</style>
