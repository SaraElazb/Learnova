@using PresentationLayer.VMs.RoleVMs

@model List<RoleVm>

@{
    ViewData["Title"] = "Roles";
}

<h2>Roles</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Role Name</th>
            
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.Count; i++)
        {
            <tr>
                <td>@(i + 1)</td>
                <td>@Model[i].RoleName</td>
              
            </tr>
        }
    </tbody>
</table>
