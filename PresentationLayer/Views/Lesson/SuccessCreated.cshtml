@model BusinessLogicLayer.DTOs.LessonDtos.LessonDto

@{
    ViewData["Title"] = "Lesson Created";
    Layout = "_Layout2";
}

@section CustomHeadContent {
    <link rel="stylesheet" href="~/css/lesson.css">
    <style>
        .success-card {
            background-color: white;
            border-radius: var(--border-radius);
            overflow: hidden;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            max-width: 800px;
            margin: 0 auto;
        }
        
        .success-icon {
            width: 80px;
            height: 80px;
            background-color: rgba(16, 185, 129, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
        }
        
        .success-icon svg {
            color: var(--brand-teal);
        }
        
        .success-header {
            text-align: center;
            padding: 2.5rem 2rem 1.5rem;
            border-bottom: 1px solid var(--layout-border-color);
        }
        
        .success-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-gray-800);
            margin-bottom: 0.5rem;
        }
        
        .success-subtitle {
            color: var(--text-gray-600);
            max-width: 500px;
            margin: 0 auto;
        }
        
        .success-content {
            padding: 2rem;
        }
        
        .lesson-details {
            background-color: var(--light-gray);
            border-radius: var(--border-radius);
            padding: 1.5rem;
            margin-bottom: 2rem;
        }
        
        .detail-item {
            margin-bottom: 1rem;
            display: flex;
            gap: 0.5rem;
            align-items: center;
        }
        
        .detail-item:last-child {
            margin-bottom: 0;
        }
        
        .detail-label {
            font-weight: 600;
            color: var(--text-gray-700);
            min-width: 100px;
        }
        
        .detail-value {
            color: var(--text-gray-800);
        }
        
        .success-actions {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            justify-content: center;
            margin-top: 2rem;
        }
        
        .lesson-btn {
            position: relative;
            overflow: hidden;
        }
        
        .lesson-btn::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 5px;
            height: 5px;
            background: rgba(255, 255, 255, 0.5);
            opacity: 0;
            border-radius: 100%;
            transform: scale(1, 1) translate(-50%);
            transform-origin: 50% 50%;
        }
        
        .lesson-btn:hover::after {
            animation: ripple 0.6s ease-out;
        }
        
        @@keyframes ripple {
            0% {
                transform: scale(0, 0);
                opacity: 0.5;
            }
            20% {
                transform: scale(25, 25);
                opacity: 0.3;
            }
            100% {
                opacity: 0;
                transform: scale(40, 40);
            }
        }
        
        /* Confetti animation */
        .confetti {
            position: fixed;
            width: 10px;
            height: 10px;
            background-color: #f2d74e;
            opacity: 0;
            animation: confetti 5s ease-in-out infinite;
            z-index: -1;
        }
        .confetti:nth-child(1) {
            background-color: #f2d74e;
            left: 7%;
            animation-delay: 0s;
        }
        .confetti:nth-child(2) {
            background-color: #95c3de;
            left: 14%;
            animation-delay: 0.5s;
        }
        .confetti:nth-child(3) {
            background-color: #ff9a91;
            left: 21%;
            animation-delay: 1s;
        }
        .confetti:nth-child(4) {
            background-color: #f2d74e;
            left: 28%;
            animation-delay: 1.5s;
        }
        .confetti:nth-child(5) {
            background-color: #95c3de;
            left: 35%;
            animation-delay: 2s;
        }
        .confetti:nth-child(6) {
            background-color: #ff9a91;
            left: 42%;
            animation-delay: 2.5s;
        }
        .confetti:nth-child(7) {
            background-color: #f2d74e;
            left: 49%;
            animation-delay: 3s;
        }
        .confetti:nth-child(8) {
            background-color: #95c3de;
            left: 56%;
            animation-delay: 3.5s;
        }
        .confetti:nth-child(9) {
            background-color: #ff9a91;
            left: 63%;
            animation-delay: 4s;
        }
        .confetti:nth-child(10) {
            background-color: #f2d74e;
            left: 70%;
            animation-delay: 4.5s;
        }
        .confetti:nth-child(11) {
            background-color: #95c3de;
            left: 77%;
            animation-delay: 5s;
        }
        .confetti:nth-child(12) {
            background-color: #ff9a91;
            left: 84%;
            animation-delay: 5.5s;
        }
        .confetti:nth-child(13) {
            background-color: #f2d74e;
            left: 91%;
            animation-delay: 6s;
        }
        
        @@keyframes confetti {
            0% {
                opacity: 1;
                transform: translateY(-100vh) rotate(0deg);
            }
            100% {
                opacity: 0;
                transform: translateY(100vh) rotate(360deg);
            }
        }
    </style>
}

<!-- Confetti elements -->
<div class="confetti"></div>
<div class="confetti"></div>
<div class="confetti"></div>
<div class="confetti"></div>
<div class="confetti"></div>
<div class="confetti"></div>
<div class="confetti"></div>
<div class="confetti"></div>
<div class="confetti"></div>
<div class="confetti"></div>
<div class="confetti"></div>
<div class="confetti"></div>
<div class="confetti"></div>

<div class="lesson-container">
    <div class="lesson-breadcrumb animate-fade-in">
        <a asp-controller="Course" asp-action="AdminIndex" class="breadcrumb-link">Courses</a>
        <span class="lesson-breadcrumb-separator">•</span>
        <a asp-action="AdminIndex" class="breadcrumb-link">Lessons</a>
        <span class="lesson-breadcrumb-separator">•</span>
        <span>Success</span>
    </div>

    <div class="success-card animate-fade-in animate-delay-100">
        <div class="success-header">
            <div class="success-icon animate-fade-in animate-delay-300">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
            </div>
            <h1 class="success-title animate-fade-in animate-delay-400">Lesson Created Successfully</h1>
            <p class="success-subtitle animate-fade-in animate-delay-500">Your new lesson has been created and is now available in the course.</p>
        </div>
        
        <div class="success-content">
            <div class="lesson-details animate-fade-in animate-delay-600">
                <div class="detail-item">
                    <div class="detail-label">Title:</div>
                    <div class="detail-value">@ViewBag.LessonTitle</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Course:</div>
                    <div class="detail-value">@ViewBag.CourseName</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Order:</div>
                    <div class="detail-value">@ViewBag.LessonOrder</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Duration:</div>
                    <div class="detail-value">@ViewBag.Duration minutes</div>
                </div>
            </div>
            
            <div class="success-actions animate-fade-in animate-delay-700">
                <a asp-action="Edit" asp-route-id="@ViewBag.LessonId" class="lesson-btn lesson-btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                    Edit Lesson
                </a>
                <a asp-action="Create" class="lesson-btn lesson-btn-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Create Another
                </a>
                <a asp-action="AdminIndex" class="lesson-btn lesson-btn-outline">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    Back to Lessons
                </a>
            </div>
        </div>
    </div>
</div>

@section CustomScripts {
    <script>
        $(document).ready(function() {
            // Enhanced animations with staggered timing
            const fadeElements = document.querySelectorAll('.animate-fade-in');
            fadeElements.forEach(function(element, index) {
                setTimeout(() => {
                    element.classList.add('visible');
                }, 50 * index);
            });
        });
    </script>
} 