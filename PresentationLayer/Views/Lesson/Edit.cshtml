@model BusinessLogicLayer.DTOs.LessonDtos.LessonRequest

@{
    ViewData["Title"] = "Edit Lesson";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">Edit Lesson</h2>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Lesson_ID" />
                        
                        <div class="mb-3">
                            <label asp-for="Course_ID" class="form-label">Course</label>
                            <select asp-for="Course_ID" class="form-select" asp-items="Model.CourseSelectList"></select>
                            <span asp-validation-for="Course_ID" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Title</label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="LessonOrder" class="form-label">Order</label>
                                <input asp-for="LessonOrder" class="form-control" type="number" min="1" />
                                <span asp-validation-for="LessonOrder" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Duration" class="form-label">Duration (minutes)</label>
                                <input asp-for="Duration" class="form-control" type="number" min="1" />
                                <span asp-validation-for="Duration" class="text-danger"></span>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="VideoUri" class="form-label">Video URL</label>
                            <input asp-for="VideoUri" class="form-control" />
                            <span asp-validation-for="VideoUri" class="text-danger"></span>
                            <small class="form-text text-muted">Enter a YouTube or other video platform URL</small>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        
                        <div class="d-flex justify-content-between">
                            <a asp-action="AdminIndex" class="btn btn-secondary">Back to List</a>
                            <button type="submit" class="btn btn-primary">Save</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 