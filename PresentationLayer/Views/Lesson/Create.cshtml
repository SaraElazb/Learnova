@model BusinessLogicLayer.DTOs.LessonDtos.LessonRequest

@{
    ViewData["Title"] = "Create Lesson";
    Layout = "_Layout2";
}

@section CustomHeadContent {
    <link rel="stylesheet" href="~/css/lesson.css">
    <style>
        .form-group {
            margin-bottom: 1.5rem;
            transition: transform 0.2s ease;
        }
        
        .form-control:focus {
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
            border-color: var(--brand-teal);
        }
        
        .form-textarea {
            display: block;
            width: 100%;
            padding: 0.75rem;
            font-size: 0.95rem;
            line-height: 1.5;
            border: 1px solid var(--layout-border-color);
            border-radius: var(--border-radius);
            background-color: white;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
            min-height: 200px;
            resize: vertical;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }
        
        .form-textarea:focus {
            outline: none;
            border-color: var(--brand-teal);
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
        }
        
        .lesson-btn {
            position: relative;
            overflow: hidden;
        }
        
        .lesson-btn::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 5px;
            height: 5px;
            background: rgba(255, 255, 255, 0.5);
            opacity: 0;
            border-radius: 100%;
            transform: scale(1, 1) translate(-50%);
            transform-origin: 50% 50%;
        }
        
        .lesson-btn:hover::after {
            animation: ripple 0.6s ease-out;
        }
        
        @@keyframes ripple {
            0% {
                transform: scale(0, 0);
                opacity: 0.5;
            }
            20% {
                transform: scale(25, 25);
                opacity: 0.3;
            }
            100% {
                opacity: 0;
                transform: scale(40, 40);
            }
        }
        
        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(255, 255, 255, 0.8);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }
        
        .loading-overlay.visible {
            opacity: 1;
            pointer-events: all;
        }
        
        .loading-spinner {
            width: 50px;
            height: 50px;
            border: 5px solid rgba(16, 185, 129, 0.2);
            border-radius: 50%;
            border-top-color: var(--brand-teal);
            animation: spin 1s ease-in-out infinite;
        }
        
        @@keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
}

<div class="loading-overlay" id="loadingOverlay">
    <div class="loading-spinner"></div>
</div>

<div class="lesson-container">
    <div class="lesson-breadcrumb animate-fade-in">
        <a asp-controller="Course" asp-action="AdminIndex" class="breadcrumb-link">Courses</a>
        <span class="lesson-breadcrumb-separator">•</span>
        <a asp-action="AdminIndex" class="breadcrumb-link">Lessons</a>
        <span class="lesson-breadcrumb-separator">•</span>
        <span>Create</span>
    </div>

    <div class="lesson-header">
        <h1 class="lesson-title animate-fade-in">Create New Lesson</h1>
    </div>

    <div class="lesson-content animate-fade-in animate-delay-100">
        <div class="lesson-main animate-fade-in animate-delay-200" style="box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="lesson-alert lesson-alert-success">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    <p>@TempData["SuccessMessage"]</p>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="lesson-alert lesson-alert-error">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <p>@TempData["ErrorMessage"]</p>
                </div>
            }

            <form asp-action="Create" id="lessonForm" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                
                <div class="form-container" style="padding: 2rem;">
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Title" class="form-label">Title</label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="validation-error"></span>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Course_ID" class="form-label">Course</label>
                            <select asp-for="Course_ID" class="form-control" asp-items="Model.CourseSelectList">
                                <option value="">-- Select Course --</option>
                            </select>
                            <span asp-validation-for="Course_ID" class="validation-error"></span>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="LessonOrder" class="form-label">Order</label>
                            <input asp-for="LessonOrder" class="form-control" type="number" min="1" />
                            <span asp-validation-for="LessonOrder" class="validation-error"></span>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Duration" class="form-label">Duration (minutes)</label>
                            <input asp-for="Duration" class="form-control" type="number" min="1" />
                            <span asp-validation-for="Duration" class="validation-error"></span>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="VideoUri" class="form-label">Video URL</label>
                            <input asp-for="VideoUri" class="form-control" />
                            <span asp-validation-for="VideoUri" class="validation-error"></span>
                            <div class="form-help-text">Enter a YouTube or other video platform URL</div>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-textarea" rows="8" placeholder="Enter lesson description here..."></textarea>
                            <span asp-validation-for="Description" class="validation-error"></span>
                        </div>
                    </div>
                    
                    <div class="form-actions">
                        <button type="submit" class="lesson-btn lesson-btn-primary" id="submitBtn">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            Create Lesson
                        </button>
                        <a asp-action="AdminIndex" class="lesson-btn lesson-btn-secondary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="19" y1="12" x2="5" y2="12"></line>
                                <polyline points="12 19 5 12 12 5"></polyline>
                            </svg>
                            Back to List
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section CustomScripts {
    <script>
        $(document).ready(function() {
            // Enhanced animations with staggered timing
            const fadeElements = document.querySelectorAll('.animate-fade-in');
            fadeElements.forEach(function(element, index) {
                setTimeout(() => {
                    element.classList.add('visible');
                }, 50 * index);
            });
            
            // Show loading overlay on form submit
            $('#lessonForm').on('submit', function() {
                document.getElementById('loadingOverlay').classList.add('visible');
            });
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 