@model IEnumerable<BusinessLogicLayer.DTOs.LessonDtos.LessonDto>

@{
    ViewData["Title"] = "Lessons Management";
}

<div class="container mt-4">
    <h1>Lessons Management</h1>
    
    <p>
        <a asp-action="Create" class="btn btn-primary">Create New Lesson</a>
    </p>
    
    <div class="table-responsive">
        <table class="table table-bordered table-hover">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Course</th>
                    <th>Order</th>
                    <th>Duration</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.CourseName</td>
                        <td>@item.LessonOrder</td>
                        <td>@item.Duration min</td>
                        <td>
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.Lesson_ID" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.Lesson_ID" class="btn btn-sm btn-outline-info">Details</a>
                                <a asp-action="Delete" asp-route-id="@item.Lesson_ID" class="btn btn-sm btn-outline-danger" 
                                   onclick="return confirm('Are you sure you want to delete this lesson?');">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div> 