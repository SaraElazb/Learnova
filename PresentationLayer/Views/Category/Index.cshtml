@model IEnumerable<BusinessLogicLayer.DTOs.CategoryDtos.CategoryDTO>

@{
    ViewBag.Title = "Categories-List";
    Layout = "_AdminLayout";
}

@section CustomHeadContent {
    <link rel="stylesheet" href="~/css/categories-list.css" />
}

<div class="page-main-container">
  <div class="app-container">
    <header class="header">
      <a asp-controller="Admin" asp-action="Dashboard" class="back-button">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M10.5 12.5L5.5 7.5L10.5 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back to Dashboard
      </a>
      <a asp-controller="Category" asp-action="Create" class="add-category-button">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M8 3.5V12.5M3.5 8H12.5" stroke="#10B981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Add New Category
      </a>
    </header>

    <main class="page-main-content">
      <section class="categories-header">
        <h1>Categories</h1>
        <p>Manage your course categories and organize your content effectively.</p>
      </section>

      <section class="categories-list-section">
        <div class="categories-filter">
          <div class="search-container">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M17.5 17.5L14.5834 14.5833M16.6667 9.58333C16.6667 13.4954 13.4954 16.6667 9.58333 16.6667C5.67132 16.6667 2.5 13.4954 2.5 9.58333C2.5 5.67132 5.67132 2.5 9.58333 2.5C13.4954 2.5 16.6667 5.67132 16.6667 9.58333Z" stroke="#6B7280" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <input type="text" id="searchCategories" class="search-input" placeholder="Search categories..." />
          </div>
       
        </div>
        <div class="categories-grid" id="categoriesContainer">
          <!-- Category cards will be generated by JavaScript -->
        </div>
      </section>
    </main>
  </div>

  <div class="delete-modal">
    <div class="delete-modal-content">
      <div class="delete-modal-header">
        <h3 class="delete-modal-title">Delete Category</h3>
      </div>
      <div class="delete-modal-body">
        <p>Are you sure you want to delete "<span class="category-to-delete"></span>"? This action cannot be undone.</p>
        <p class="subcategories-warning">This will also delete all subcategories associated with this category.</p>
      </div>
      <div class="delete-modal-actions">
        <button class="delete-cancel-button">Cancel</button>
        <button class="delete-confirm-button">Delete</button>
      </div>
    </div>
  </div>
</div>

@section CustomScripts {
  <script>
        var categoriesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
        console.log("categoriesData from Razor:", categoriesData);
    </script>

  <script src="~/js/categories-list.js"></script>
}
